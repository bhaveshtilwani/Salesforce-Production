<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <isExposed>true</isExposed>

    <targets>
        <target>lightning__FlowScreen</target>
    </targets>

    <targetConfigs>
        <targetConfig targets="lightning__FlowScreen">

            <property
                name="Existing_Revenue_Recognition_Type"
                type="String"
                label="Existing Revenue Recognition Type"
                description="Pass in the saved value from Get Records → RevenueRecognitionType__c"
                role="inputOnly"
            />
            <property
                name="Product_Type"
                type="String"
                label="Product Type"
                description="Maps to Flow variable: Product_Type"
                role="inputOnly"
            />
            <property
                name="Custom_vs_Standard"
                type="String"
                label="Custom vs Standard"
                description="Maps to Flow variable: Custom_vs_Standard"
                role="inputOnly"
            />
            <property
                name="Agreement_Type"
                type="String"
                label="Agreement Type"
                description="Maps to Flow variable: Agreement_Type"
                role="inputOnly"
            />
            <property
                name="MSA_LTSA_Reference"
                type="String"
                label="MSA / LTSA Reference"
                description="Maps to Flow variable: MSA_LTSA_Reference"
                role="inputOnly"
            />
            <property
                name="Right_to_Cost_Profit_Upon_Cancellation"
                type="String"
                label="Right to Cost + Profit Upon Cancellation"
                description="Maps to Flow variable: Right_to_Cost_Profit_Upon_Cancellation"
                role="inputOnly"
            />

        </targetConfig>
    </targetConfigs>

</LightningComponentBundle>