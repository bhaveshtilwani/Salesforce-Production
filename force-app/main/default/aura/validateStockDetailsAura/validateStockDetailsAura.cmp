<aura:component implements="flexipage:availableForRecordHome,force:hasRecordId,force:lightningQuickActionWithoutHeader" 
                access="global" controller="ValidateStockDetailsController"><!--force:lightningQuickAction, -->
    <aura:attribute name="recordId" type="String" />
    <aura:attribute name="status" type="String" default="Checking stock details..." />
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>
    <center><P>{!v.status}</P></center>
    
</aura:component>