<aura:component
    controller="DisplayAccountRecordsCtrl"
    implements="force:hasRecordId,force:appHostable,forceCommunity:availableForAllPageTypes,flexipage:availableForAllPageTypes"
    access="global"
>
    <aura:handler name="init" value="{!this}" action="{!c.doInit}" />
    <aura:attribute name="accLst" type="Account[]" />
    <article class="slds-card">
        <div class="slds-card__header slds-grid">
            <header class="slds-media slds-media_center slds-has-flexi-truncate">
                <div class="slds-media__figure">
                    <span class="slds-icon_container slds-icon-standard-account" title="Account">
                        <lightning:icon iconName="standard:account" size="medium" alternativeText="Account List" />
                    </span>
                </div>
                <div class="slds-media__body">
                    <h2>
                        <a href="javascript:void(0);" class="slds-card__header-link slds-truncate" title="Account">
                            <span class="slds-text-heading_small">Current Terms</span>
                        </a>
                    </h2>
                </div>
            </header>
        </div>
        <div class="slds-card__body">
            <table class="slds-table slds-table_bordered slds-no-row-hover slds-table_cell-buffer">
                <thead>
                    <tr class="slds-text-title_caps">
                        <th scope="col">
                            <div class="slds-truncate" title="Name">ERP Account Name</div>
                        </th>
                        <th scope="col">
                            <div class="slds-truncate" title="PKI_Site__c">Excelitas Site</div>
                        </th>
                        <th scope="col">
                            <div class="slds-truncate" title="Credit_Terms__c">Credit Term</div>
                        </th>
                        <th scope="col">
                            <div class="slds-truncate" title="Credit_Terms_Desc__c">Credit Terms Desc</div>
                        </th>
                        <th scope="col">
                            <div class="slds-truncate" title="Credit_Terms_Desc__c">Payment Term</div>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    <aura:iteration items="{!v.accLst}" var="record">
                        <tr data-id="{!record.Id}" onclick="{!c.handleRowClick}">
                            <td><a href="javascript:void(0);" data-id="{!record.Id}">{!record.Name}</a></td>
                            <td>{!record.PKI_Site__c}</td>
                            <td>{!record.Credit_Terms__c}</td>
                            <td>{!record.Credit_Terms_Desc__c}</td>
                            <td>{!record.PaymentTerm__r.Name}</td>
                        </tr>
                    </aura:iteration>
                </tbody>
            </table>
        </div>
        <footer class="slds-card__footer"><a href="javascript:void(0);"></a></footer>
    </article>
</aura:component>