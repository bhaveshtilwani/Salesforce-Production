 -->

 
        <apex:panelGrid columns="1" width="100%" styleClass="summarySection" cellpadding="4">
            <apex:facet name="header">Ship To: {!order.Ship_To_CodeLDGI__c}</apex:facet>
            <apex:outputText value="{5}<br/>{0}<br/>{1}, {2} {3}<br/>{4}" escape="false">
