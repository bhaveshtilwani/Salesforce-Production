        <apex:outputLabel value="Ship Via:"/>
        <apex:outputField value="{!order.Ship_Via__c}"/>

        <apex:outputLabel value="Attention:"/>
        <apex:outputField value="{!order.Contact__r.Name}"/>
        
        <apex:outputLabel value="Shipping Vendor:"/>
