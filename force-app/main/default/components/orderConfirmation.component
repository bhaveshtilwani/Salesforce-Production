        <apex:outputLabel value="Transaction /Order Comments 2:"/>
        <apex:outputField value="{!order.Transaction_Order_Comments_2__c}"/>
        
        <apex:outputLabel value="Transaction /Order Comments 3:"/>
        <apex:outputField value="{!order.Transaction_Order_Comments_3__c}"/>
        
        <apex:outputLabel value="Transaction /Order Comments 4:"/>
        <apex:outputField value="{!order.Transaction_Order_Comments_4__c}"/>-->
