<body lang=EN-US link=black vlink=purple style='tab-interval:.5in'>

<div class=Section1>

<table class=MsoNormalTable border=1 cellspacing=0 cellpadding=0 width="100%"
 style='width:100.0%;mso-cellspacing:0in;mso-padding-alt:2.25pt 2.25pt 2.25pt 2.25pt'>
 <tr style='mso-yfti-irow:0;mso-yfti-firstrow:yes'>
  <td colspan=2 valign=top style='background:#999999;padding:2.25pt 2.25pt 2.25pt 2.25pt'>
  <p class=MsoNormal align=center style='text-align:center'><span
  class=helphead21><span style='color:white'>Prospect Field<a
  name=OpportunitiesFieldEntries></a><a name=1747815></a> Definitions</span></span></p>
  </td>
 </tr>
 <tr style='mso-yfti-irow:1'>
  <td width="19%" style='width:19.18%;background:#999999;padding:2.25pt 2.25pt 2.25pt 2.25pt'>
  <p class=MsoNormal align=center style='text-align:center'><a name=1747808></a><a
  name=1747811></a><a name=1747816></a><a name=1747819></a><b><span
  style='font-size:10.0pt;font-family:Arial;color:white'>Field<o:p></o:p></span></b></p>
  </td>
  <td width="80%" style='width:80.82%;background:#999999;padding:2.25pt 2.25pt 2.25pt 2.25pt'>
  <p class=MsoNormal align=center style='text-align:center'><a name=1747821></a><b><span
  style='font-size:10.0pt;font-family:Arial;color:white'>Description<o:p></o:p></span></b></p>
  </td>
 </tr>
 <tr style='mso-yfti-irow:2'>
  <td width="19%" valign=top style='width:19.18%;background:#F9F9F9;padding:
  2.25pt 2.25pt 2.25pt 2.25pt'>
  <p class=MsoNormal><a name=1747823></a><span class=fieldname1><span
  style='font-size:9.0pt'>Account Name</span></span><span style='font-size:
  9.0pt;font-family:Arial;color:black'><o:p></o:p></span></p>
  </td>
  <td width="80%" valign=top style='width:80.82%;background:#F9F9F9;padding:
  2.25pt 2.25pt 2.25pt 2.25pt'>
  <p class=MsoNormal><a name=1747825></a><span style='font-size:9.0pt;
  font-family:Arial;color:black'>Name of account that Prospect is linked to.
  You can enter the account name, or select the account using the <em><span
  style='font-family:Arial'>lookup</span></em> icon. <o:p></o:p></span></p>
  </td>
 </tr>
 <tr style='mso-yfti-irow:3'>
  <td width="19%" valign=top style='width:19.18%;background:#F9F9F9;padding:
  2.25pt 2.25pt 2.25pt 2.25pt'>
  <p class=MsoNormal><a name=1747827></a><span class=fieldname1><span
  style='font-size:9.0pt'>Amount</span></span><span style='font-size:9.0pt;
  font-family:Arial;color:black'><o:p></o:p></span></p>
  </td>
  <td width="80%" valign=top style='width:80.82%;background:#F9F9F9;padding:
  2.25pt 2.25pt 2.25pt 2.25pt'>
  <p class=MsoNormal><a name=1747829></a><b style='mso-bidi-font-weight:normal'><span
  style='font-size:9.0pt;font-family:Arial;color:red'>Value of 1st
  full&nbsp;&nbsp; year&nbsp; production</span></b><a name=1747830></a><b
  style='mso-bidi-font-weight:normal'><span style='font-size:9.0pt;font-family:
  Arial;color:black'><o:p></o:p></span></b></p>
  </td>
 </tr>
 <tr style='mso-yfti-irow:4'>
  <td width="19%" valign=top style='width:19.18%;background:#F9F9F9;padding:
  2.25pt 2.25pt 2.25pt 2.25pt'>
  <p class=MsoNormal><a name=1747832></a><a name=1747836></a><a name=1747842></a><span
  class=fieldname1><span style='font-size:9.0pt'>Close Date</span></span><span
  style='font-size:9.0pt;font-family:Arial;color:black'><o:p></o:p></span></p>
  </td>
  <td width="80%" valign=top style='width:80.82%;background:#F9F9F9;padding:
  2.25pt 2.25pt 2.25pt 2.25pt'>
  <p class=MsoNormal><a name=1747844></a><span style='font-size:9.0pt;
  font-family:Arial;color:black'>Date when you plan to close </span><span
  style='font-size:9.0pt;font-family:Arial;color:red'>the program and
  &#8220;Status&#8221; will be changed to Won, Lost, or NFA and
  &#8220;Stage&#8221; will be changed to &#8220;5 &#8211; Business Award&#8221;
  (or to &#8220;6 &#8211; Production Order on Backlog&#8221; if PO received)</span><span
  style='font-size:9.0pt;font-family:Arial;color:black'>. You can add the
  current date by clicking the date link next to the field. </span><a
  name=1747845></a><b style='mso-bidi-font-weight:normal'><span
  style='font-size:9.0pt;font-family:Arial;color:red'>When we
  have&nbsp;&nbsp;&nbsp; starting shipping&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
  production units</span></b><span style='font-size:9.0pt;font-family:Arial;
  color:black'><o:p></o:p></span></p>
  </td>
 </tr>
 <tr style='mso-yfti-irow:5'>
  <td width="19%" valign=top style='width:19.18%;background:#F9F9F9;padding:
  2.25pt 2.25pt 2.25pt 2.25pt'>
  <p class=MsoNormal><a name=1747847></a><span class=fieldname1><span
  style='font-size:9.0pt'>Created By</span></span><span style='font-size:9.0pt;
  font-family:Arial;color:black'><o:p></o:p></span></p>
  </td>
  <td width="80%" valign=top style='width:80.82%;background:#F9F9F9;padding:
  2.25pt 2.25pt 2.25pt 2.25pt'>
  <p class=MsoNormal><a name=1747849></a><span style='font-size:9.0pt;
  font-family:Arial;color:black'>User who created the Prospect including
  creation date and time. (Read only)<o:p></o:p></span></p>
  </td>
 </tr>
 <tr style='mso-yfti-irow:6'>
  <td width="19%" valign=top style='width:19.18%;background:#F9F9F9;padding:
  2.25pt 2.25pt 2.25pt 2.25pt'>
  <p class=MsoNormal><a name=1747851></a><span class=fieldname1><span
  style='font-size:9.0pt'>Description</span></span><span style='font-size:9.0pt;
  font-family:Arial;color:black'><o:p></o:p></span></p>
  </td>
  <td width="80%" valign=top style='width:80.82%;background:#F9F9F9;padding:
  2.25pt 2.25pt 2.25pt 2.25pt'>
  <p class=MsoNormal><a name=1747853></a><span style='font-size:9.0pt;
  font-family:Arial;color:black'>Description of the Prospect. Up to 32KB of
  data are allowed. Only the first 255 characters display in reports.<o:p></o:p></span></p>
  </td>
 </tr>
 <tr style='mso-yfti-irow:7'>
  <td width="19%" valign=top style='width:19.18%;background:#F9F9F9;padding:
  2.25pt 2.25pt 2.25pt 2.25pt'>
  <p class=MsoNormal><a name=1747855></a><span class=fieldname1><span
  style='font-size:9.0pt'>Expected Revenue</span></span><span style='font-size:
  9.0pt;font-family:Arial;color:black'><o:p></o:p></span></p>
  </td>
  <td width="80%" valign=top style='width:80.82%;background:#F9F9F9;padding:
  2.25pt 2.25pt 2.25pt 2.25pt'>
  <p class=MsoNormal><a name=1747857></a><span style='font-size:9.0pt;
  font-family:Arial;color:black'>Calculated revenue based on the </span><span
  class=fieldname1><span style='font-size:9.0pt'>Amount</span></span><span
  style='font-size:9.0pt;font-family:Arial;color:black'> and </span><span
  class=fieldname1><span style='font-size:9.0pt'>Probability</span></span><span
  style='font-size:9.0pt;font-family:Arial;color:black'> fields.<o:p></o:p></span></p>
  </td>
 </tr>
 <tr style='mso-yfti-irow:8'>
  <td width="19%" valign=top style='width:19.18%;background:#F9F9F9;padding:
  2.25pt 2.25pt 2.25pt 2.25pt'>
  <p class=MsoNormal><a name=1747859></a><a name=1747863></a><span
  class=fieldname1><span style='font-size:9.0pt'>Modified By</span></span><span
  style='font-size:9.0pt;font-family:Arial;color:black'><o:p></o:p></span></p>
  </td>
  <td width="80%" valign=top style='width:80.82%;background:#F9F9F9;padding:
  2.25pt 2.25pt 2.25pt 2.25pt'>
  <p class=MsoNormal><a name=1747865></a><span style='font-size:9.0pt;
  font-family:Arial;color:black'>User who last changed the Prospect fields,
  including modification date and time. <o:p></o:p></span></p>
  </td>
 </tr>
 <tr style='mso-yfti-irow:9'>
  <td width="19%" valign=top style='width:19.18%;background:#F9F9F9;padding:
  2.25pt 2.25pt 2.25pt 2.25pt'>
  <p class=MsoNormal><a name=1747867></a><a name=1747871></a><span
  class=fieldname1><span style='font-size:9.0pt'>Currency</span></span><span
  style='font-size:9.0pt;font-family:Arial;color:black'><o:p></o:p></span></p>
  </td>
  <td width="80%" valign=top style='width:80.82%;background:#F9F9F9;padding:
  2.25pt 2.25pt 2.25pt 2.25pt'>
  <p class=MsoNormal><a name=1747873></a><span style='font-size:9.0pt;
  font-family:Arial;color:black'>The default currency for all currency amount
  fields in the Prospect. <o:p></o:p></span></p>
  </td>
 </tr>
 <tr style='mso-yfti-irow:10'>
  <td width="19%" valign=top style='width:19.18%;background:#F9F9F9;padding:
  2.25pt 2.25pt 2.25pt 2.25pt'>
  <p class=MsoNormal><a name=1747876></a><a name=1747881></a><span
  class=fieldname1><span style='font-size:9.0pt'>Prospect Name</span></span><span
  style='font-size:9.0pt;font-family:Arial;color:black'><o:p></o:p></span></p>
  </td>
  <td width="80%" valign=top style='width:80.82%;background:#F9F9F9;padding:
  2.25pt 2.25pt 2.25pt 2.25pt'>
  <p class=MsoNormal><a name=1747883></a><span style='font-size:9.0pt;
  font-family:Arial;color:black'>Name of the Prospect, for example, Acme.com -
  Office Equipment Order. Up to 80 characters are allowed in this field.<o:p></o:p></span></p>
  </td>
 </tr>
 <tr style='mso-yfti-irow:11'>
  <td width="19%" valign=top style='width:19.18%;background:#F9F9F9;padding:
  2.25pt 2.25pt 2.25pt 2.25pt'>
  <p class=MsoNormal><a name=1747885></a><span class=fieldname1><span
  style='font-size:9.0pt'>Prospect Owner</span></span><span style='font-size:
  9.0pt;font-family:Arial;color:black'><o:p></o:p></span></p>
  </td>
  <td width="80%" valign=top style='width:80.82%;background:#F9F9F9;padding:
  2.25pt 2.25pt 2.25pt 2.25pt'>
  <p class=MsoNormal><a name=1747887></a><span style='font-size:9.0pt;
  font-family:Arial;color:black'>Assigned owner of Prospect.<o:p></o:p></span></p>
  </td>
 </tr>
 <tr style='mso-yfti-irow:12'>
  <td width="19%" valign=top style='width:19.18%;background:#F9F9F9;padding:
  2.25pt 2.25pt 2.25pt 2.25pt'>
  <p class=MsoNormal><a name=1747889></a><a name=1747893></a><a name=1747898></a><span
  class=fieldname1><span style='font-size:9.0pt'>Probability</span></span><span
  style='font-size:9.0pt;font-family:Arial;color:black'><o:p></o:p></span></p>
  </td>
  <td width="80%" valign=top style='width:80.82%;background:#F9F9F9;padding:
  2.25pt 2.25pt 2.25pt 2.25pt'>
  <p class=MsoNormal><a name=1747900></a><span style='font-size:9.0pt;
  font-family:Arial;color:black'>Percentage of estimated confidence in closing
  the Prospect. <a name=1747901></a>The </span><span class=fieldname1><span
  style='font-size:9.0pt'>Probability</span></span><span style='font-size:9.0pt;
  font-family:Arial;color:black'> value is always updated by a change in the </span><span
  class=fieldname1><span style='font-size:9.0pt'>Stage</span></span><span
  style='font-size:9.0pt;font-family:Arial;color:black'> value, even if </span><span
  class=fieldname1><span style='font-size:9.0pt'>Probability</span></span><span
  style='font-size:9.0pt;font-family:Arial;color:black'> is marked as read only
  on your page layout. </span><b style='mso-bidi-font-weight:normal'><span
  style='font-size:9.0pt;font-family:Arial;color:red'>This does not need to be
  tied to stage - please independently enter</span></b><span style='font-size:
  9.0pt;font-family:Arial;color:black'><o:p></o:p></span></p>
  </td>
 </tr>
 <tr style='mso-yfti-irow:13'>
  <td width="19%" valign=top style='width:19.18%;background:#F9F9F9;padding:
  2.25pt 2.25pt 2.25pt 2.25pt'>
  <p class=MsoNormal><a name=1747903></a><span class=fieldname1><span
  style='font-size:9.0pt'>Stage</span></span><span style='font-size:9.0pt;
  font-family:Arial;color:black'><o:p></o:p></span></p>
  </td>
  <td width="80%" valign=top style='width:80.82%;background:#F9F9F9;padding:
  2.25pt 2.25pt 2.25pt 2.25pt'>
  <p class=MsoNormal><a name=1747905></a><span style='font-size:9.0pt;
  font-family:Arial;color:black'>Current stage of Prospect based on selections
  you make from a predefined list<a name=1747906></a>.<o:p></o:p></span></p>
  </td>
 </tr>
 <tr style='mso-yfti-irow:14'>
  <td width="19%" valign=top style='width:19.18%;background:#F9F9F9;padding:
  2.25pt 2.25pt 2.25pt 2.25pt'>
  <p class=MsoNormal><a name=1747908></a><span class=fieldname1><span
  style='font-size:9.0pt'>Type</span></span><span style='font-size:9.0pt;
  font-family:Arial;color:black'><o:p></o:p></span></p>
  </td>
  <td width="80%" valign=top style='width:80.82%;background:#F9F9F9;padding:
  2.25pt 2.25pt 2.25pt 2.25pt'>
  <p class=MsoNormal><a name=1747910></a><span style='font-size:9.0pt;
  font-family:Arial;color:black'>Type of Prospect, for example, Existing
  Business or New Business. <o:p></o:p></span></p>
  </td>
 </tr>
 <tr style='mso-yfti-irow:15'>
  <td width="19%" valign=top style='width:19.18%;background:#F9F9F9;padding:
  2.25pt 2.25pt 2.25pt 2.25pt'>
  <p class=MsoNormal><a name=1747912></a><span class=fieldname1><span
  style='font-size:9.0pt;color:red'>Status</span></span><span style='font-size:
  9.0pt;font-family:Arial;color:red'><o:p></o:p></span></p>
  </td>
  <td width="80%" valign=top style='width:80.82%;background:#F9F9F9;padding:
  2.25pt 2.25pt 2.25pt 2.25pt'>
  <p class=MsoNormal><span style='font-size:9.0pt;font-family:Arial;color:red'>Default
  to &#8220;Pending&#8221;.<span style='mso-spacerun:yes'>&nbsp; </span>Change
  to &quot;Won&quot; when business awarded to PKI Opto; to &quot;Lost&quot;
  when learn that business awarded to competitor; to &quot;On Hold&quot; when
  informed by customer that program on hold for <b style='mso-bidi-font-weight:
  normal'>at least 6 months</b>; to &quot;NFA&quot; when informed by customer
  that program cancelled or postponed indefinitely.<o:p></o:p></span></p>
  </td>
 </tr>
 <tr style='mso-yfti-irow:16'>
  <td width="19%" valign=top style='width:19.18%;background:#F9F9F9;padding:
  2.25pt 2.25pt 2.25pt 2.25pt'>
  <p class=MsoNormal><span style='font-size:9.0pt;font-family:"Courier New";
  color:red'>Production <st1:place w:st="on">PO</st1:place> Date<o:p></o:p></span></p>
  </td>
  <td width="80%" valign=top style='width:80.82%;background:#F9F9F9;padding:
  2.25pt 2.25pt 2.25pt 2.25pt'>
  <p class=MsoNormal><b style='mso-bidi-font-weight:normal'><span
  style='font-size:9.0pt;font-family:Arial;color:red'>This should be production
  date less our lead time<o:p></o:p></span></b></p>
  </td>
 </tr>
 <tr style='mso-yfti-irow:17'>
  <td width="19%" valign=top style='width:19.18%;background:#F9F9F9;padding:
  2.25pt 2.25pt 2.25pt 2.25pt'>
