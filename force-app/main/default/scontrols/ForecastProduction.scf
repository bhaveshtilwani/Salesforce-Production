	<script type="text/javascript">
		function twistSection(twisty) 
		{
		   var parentDiv = twisty;
		   while (parentDiv.tagName != 'DIV') { parentDiv = parentDiv.parentNode; }
		   var headerId = (parentDiv.id.split('_'))[1]; 
		   var div = parentDiv.nextSibling; 
		   var elemWasOn = false; 
		   if (div.style.display != 'none') { 
			   div.style.display = 'none'; 
			   twisty.className ='showListButton';
			   twisty.alt = twisty.title = 'Show Section - '+twisty.name;
			   elemWasOn = true; 
		   } else {
			   div.style.display = 'block'; 
			   twisty.className = 'hideListButton';
			   twisty.alt = twisty.title = 'Hide Section - '+twisty.name;
		   } 
		addTwistCookie('Twister', headerId, elemWasOn);
		}
		
		var registeredSections = new Array();
		
		function registerTwistableSection(headerId, mainTableId) 
		{
		   var obj = new Object();
		   obj.headerId = headerId;
		   obj.mainTableId = mainTableId;
		   registeredSections[registeredSections.length] = obj;
		}
		
		function twistAllSections(on) 
		{
		   for (var i = 0; i < registeredSections.length; i++) 
		   {
			  var obj = registeredSections[i];
			  var img;
			  img = document.getElementById('img_' + obj.headerId);
			if (on && 'showListButton' == img.className) 
			{
				 twistSection(img, obj.headerId, obj.mainTableId);
			} 
			else if (!on && 'hideListButton' == img.className) 
			{
				 twistSection(img, obj.headerId, obj.mainTableId);
			}
		   }
		}
		
		function toggleSection(headerId, on)
		{
			var sectionHead = document.getElementById('head_'+headerId+'_ep');
			var body = sectionHead.nextSibling;
			var disp = on ? 'block' : 'none';
			sectionHead.style.display = disp;
			body.style.display = disp;
		}
		
		function registerTwistableSections_ep() 
		{
		registerTwistableSection('01B50000002Wzu5', 'ep');
		registerTwistableSection('01B50000002QXeU', 'ep');
		registerTwistableSection('01B50000002QQUE', 'ep');
		}
		
		registerTwistableSections_ep();
	</script>

	<script language="JavaScript1.2" type="text/javascript">

	sforce.connection.init("{!API.Session_ID}","{!API.Partner_Server_URL_90}"); 
	
	function initcode() 
	{
		  var callback = 
			{
			    onSuccess : displayResultnew,
			    onFailure : displayError
			};
			
			var keyprod,allsp,allpf;
			
			if (document.AccountSearchForm.SalesPerson.value=='All')
			{
				allsp = '%';
			}
			else
			{
				allsp = "%" + document.AccountSearchForm.SalesPerson.value + "%" ;
			}
			
			if (document.AccountSearchForm.ProductFamily.value=='All')
			{
				allpf = '%';
			}
			else
			{
				allpf =  document.AccountSearchForm.ProductFamily.value  ;
			}
			
			if (document.AccountSearchForm.Included.checked==true)
			{
				keyprod="true";
				sforce.connection.query("SELECT Id,Name, Part_Description__c, CP_Include_in_Forecast__c, Sales_Rep__c,Product_Family__c, PM_Product_Number__r.Name, CP_Part_Cust_Name__r.Name,CP_Part_Cust_Name__r.Id FROM Customer_Part__c where Sales_Rep__c like '"+ allsp +"'  and CP_Include_in_Forecast__c = "+ keyprod +" and Product_Family__c like '"+ allpf +"' and  CP_Part_Cust_Name__r.Name like '%" + document.AccountSearchForm.AccountName.value + "%' and  PM_Product_Number__r.Name like '%" + document.AccountSearchForm.ProductNumber.value + "%' order by CP_Part_Cust_Name__r.Name LIMIT 100", callback);
			}
			else
			{
				//keyprod="false";
			sforce.connection.query("SELECT Id,Name, Part_Description__c, CP_Include_in_Forecast__c, Sales_Rep__c,Product_Family__c, PM_Product_Number__r.Name, CP_Part_Cust_Name__r.Name,CP_Part_Cust_Name__r.Id FROM Customer_Part__c where Sales_Rep__c like '"+ allsp +"'and Product_Family__c like '"+ allpf +"' and  CP_Part_Cust_Name__r.Name like '%" + document.AccountSearchForm.AccountName.value + "%' and  PM_Product_Number__r.Name like '%" + document.AccountSearchForm.ProductNumber.value + "%' order by CP_Part_Cust_Name__r.Name  LIMIT 100", callback);
			} 
			
			
		  //sforce.connection.query("SELECT Id,Name, Part_Description__c, CP_Include_in_Forecast__c, Sales_Rep__c, PM_Product_Number__r.Name, CP_Part_Cust_Name__r.Name,CP_Part_Cust_Name__r.Id FROM Customer_Part__c where Sales_Rep__c like '"+ allsp +"'  and CP_Include_in_Forecast__c = "+ keyprod +" and Product_Family__c like '"+ allpf +"' and  CP_Part_Cust_Name__r.Name like '%" + document.AccountSearchForm.AccountName.value + "%' and  PM_Product_Number__r.Name like '%" + document.AccountSearchForm.ProductNumber.value + "%' LIMIT 100", callback);
		  
		  npow();
	}

	function displayError(error) 
		{
			document.getElementById("ResultsHolder").innerHTML =  "oops something went wrong ... " + error;
		}

	function displayErrorPow(error) 
		{
			document.getElementById("outputpow-div").innerHTML =  "oops something went wrong ... " + error;
		}
		
	function displayErrorPowT(error) 
		{
			document.getElementById("outputpowT-div").innerHTML =  "oops something went wrong ... " + error;
		}
	
		function pageexample(page) 
		{     
			
			npow();
			
			for(var k = 0 ; k < document.getElementsByTagName("a").length ; k++)
			{
				var pageID = document.getElementsByTagName("a")[k].id;
				
				if(pageID.indexOf("page") == 0)
				{
					var pageClass = document.getElementsByTagName("a")[k].className;
					pageClass = pageClass.replace(/currentpage/, " ");
					document.getElementsByTagName("a")[k].className = pageClass;    
				}
			}

			var t = document.getElementById("t1");
			var res;
			
			if (page=="previous") 
			{
				res=Table.pagePrevious(t);
			}
			else if (page=="next") 
			{
				res=Table.pageNext(t);
			}
			else 
			{
				res=Table.page(t,page);
			}
			
			var currentPage = parseInt(res.page + 1);  

			document.getElementById("page"+currentPage).className += "currentpage";
			
		}
		
		function clearTable(tbody) 
		{
			while (tbody.rows.length > 0) 
			{
			tbody.deleteRow(0);	
			}
		}
		
		function displayResultnew(Results)
		{
			var Id,ProdName,PartDesc,CustName,incInFcast,salesrep,custid,prodfam;
			
			try
			{
				
				var mTableBody = document.getElementById("mtblBody");
			
				clearTable(mTableBody);
				
				if(Results.size <= 0)
					{
						alert("No records found. Please modify search criteria");
					}
				
				if(Results.size > 0)
				{

				var records = Results.getArray("records");
					
					for(var j=0; j<records.length; j++)
					{
						Id    =  records[j].Id;
						ProdName = records[j].PM_Product_Number__r.Name;
						PartDesc = records[j].Part_Description__c ;
						CustName  = records[j].CP_Part_Cust_Name__r.Name ;
						prodfam = records[j].Product_Family__c;
						incInFcast   = records[j].CP_Include_in_Forecast__c ;
						salesrep   =  records[j].Sales_Rep__c;
						custid = records[j].CP_Part_Cust_Name__r.Id;
						
						mTableBody.appendChild(addDBRow(Id,ProdName,PartDesc, CustName,prodfam,incInFcast,salesrep,custid,j));
					}

					pages = records.length/10;
					if(records.length%10 >0)
					pages++;
					
					document.getElementById("tfootPages").innerHTML = "";
					
					var aLink= "";
					
					for(var d=1 ; d<=pages ; d++)
					{
					
						if(d==1)
						{
							aLink = "<a href='#' id='page"+d+"' class='pagelink currentpage' onclick='pageexample("+parseInt(d-1)+"); return false;'>"+d+"</a>" ;
						}
						else
						{
							aLink = "<a href='#' id='page"+d+"' class='pagelink' onclick='pageexample("+parseInt(d-1)+"); return false;'>"+d+"</a>" ;
						}

						document.getElementById("tfootPages").innerHTML += aLink + "\r";
					}           
					pageexample("0");
				}
			}  
			catch(e) 
			{ 
				alert(e + "-" + e.message); 
			}
		}


		function addDBRow(Id1,ProdName1,PartDesc1, CustName1,prodfam1,incInFcast1,salesrep1,custid1,index, mTableBody1)
		{
			
			var Row = document.createElement("tr");
			
			if(index%2 == 0)
				Row.className = "dataRows alternate";
			else
				Row.className = "dataRows";
			
			Row.Style = " ";

			Row.id = "tr"+ index;

			var Cell1 = document.createElement("td");
			var Cell2 = document.createElement("td");
			var Cell3 = document.createElement("td");
			var Cell4 = document.createElement("td");
			var Cell5 = document.createElement("td");
			var Cell6 = document.createElement("td");
			var Cell7 = document.createElement("td");
			
			Cell1.Style = "width = 120";
			Cell2.Style = "width = 300";
			Cell3.Style = "width = 300";
			Cell4.Style = "width = 300";
			Cell5.Style = "width = 25";
			Cell6.Style = "width = 300";
			Cell7.Style = "width = 300";
			
			Cell1.innerHTML = "<input class=mth value=Forecast onClick=npow('"+Id1+"','"+ escape(ProdName1) + "','" + escape(CustName1) + "')></input>"; 
			Cell2.innerHTML = "<a href='/"+ Id1 +"' target=_blank>"+ ProdName1 +"</a>"; 
			Cell3.innerHTML = PartDesc1;  
			Cell4.innerHTML = "<a href='/"+ custid1 +"' target=_blank>" + CustName1 + "</a>";
			Cell5.innerHTML = prodfam1;			
			Cell6.innerHTML = incInFcast1; 
			Cell7.innerHTML = salesrep1; 
			
			Row.appendChild(Cell1);
			Row.appendChild(Cell2);
			Row.appendChild(Cell3);
			Row.appendChild(Cell4);
			Row.appendChild(Cell5);	
			Row.appendChild(Cell6);	
			Row.appendChild(Cell7);
			
			return Row;
			
		}				
					
					
	function pki_showCells()
			{
			   // *** Setup the variables to be used.  They will all be strings.
			   var strProb = "";
			   var strQty   = "";
			   var strPrice = "";
			   var strReturn = "";
			   var strRecid = "";
			   
			   var sobj = new sforce.SObject("Monthly_Forecast_Analysis__c");
			   
			   /*  Loop through the table rows.  By repeating the dqc input name you in effect created an
			        array and I use that array count as my counter here for the loop so if you decide to display
					more rows this will automatically expand to accomodate.  Remember that Javascrip arrays
					are zero based thus the reason to start i (increment) at zero.  
			  */
		 	   for(i=0;i <= document.frmTable.dqc.length - 1;i++)
		   			{
							strProb  = document.frmTable.prob[i].value;  
							strQty   = document.frmTable.dqc[i].value;
							strPrice = document.frmTable.fupc[i].value;
							strRecid = document.frmTable.recid[i].value;
/*alert (strQty.replace(/,/, ''));*/

strQty = strQty.replace(/,/, '');
							var checknum = valnumin(strQty);
/*alert (strQty.replace(/,/, ''));*/


							var checkcur = valnumin(strPrice);
							
							if (checknum == false && checkcur == false)
							{
								sobj.Id = strRecid;
								sobj.MFA_Probability__c = strProb;
								sobj.MFA_Additional_Demand_QTY__c = strQty;
								sobj.MFA_Forecast_Unit_Price__c = strPrice;
								sforce.connection.update([sobj]);
							}
							else
							{
								if (checknum ==true && checkcur == false)
								{
									alert("Additional demand value "+"'"+strQty+"'"+" is not valid. Please enter number .. !!");
								}
								else if (checkcur == true && checknum ==false)
								{
									alert("Forecast price value "+"'"+strPrice+"'"+" is not valid. Please enter number .. !!");
								}
								else
								{
									alert("Additional demand quantity "+"'"+strQty+"'"+" and "+"Forecast price "+"'"+strPrice+"'"+" is not valid. Please enter appropriate value .. !!");
								}	
							}
							
		   			}
					document.frmTop.status.value = "..Done";
					npow(document.frmTop.reqid.value,document.frmTop.reqpnum.value,document.frmTop.reqcid.value,document.frmTop.status.value);
			}

	function valnumin(field) 
	{ 
	                    /*field = field.replace(/,/, ''); */	
                                         if(isNaN(field)) 
		{ 
			return true; 
		} 
		else 
		{ 
			return false;	
		} 
	}
		
	function npow(strId,pnum,cid,sta)
	{
	
		function setup() 
			{
				if (!sforce.connection.sessionId) 
				{
				var sid = getCookie("sid");
					if (sid) 
					{
					sforce.connection.sessionId = sid;
					} 
					else 
					{
					window.location = "/?startURL=" + window.location;
					return;
					}
				}
			}

		
				
		var callbackPow = 
		{
		onSuccess : displayResultPow,
	    onFailure : displayErrorPow
		};
		
		var callbackPowT = 
			{
			onSuccess : displayResultPowT,
		    onFailure : displayErrorPowT
			};
	
	
		sforce.connection.query("SELECT Id, MFA_Sales_To_Date__c, MFA_Month__c, MFA_Probability__c,MFA_Forecast_Unit_Price__c,MFA_Total_Forecast_QTY__c, MFA_Total_Forecast__c, MFA_Average_Selling_Price__c, MFA_Backlog_To_Date__c, MFA_Additional_Demand__c, MFA_Backlog_To_Date_QTY__c, MFA_Additional_Demand_QTY__c, MFA_Actual_Sales_QTY__c, MFA_Past_Period__c, MFA_Year__c, MFACPID__r.Name FROM Monthly_Forecast_Analysis__c where MFACPID__r.Id = '"+ strId +"' and MFA_Past_Period__c = false order by MFA_Year__c asc LIMIT 50",callbackPow);
	


		sforce.connection.query("SELECT Id, MFA_Sales_To_Date__c, MFA_Month__c,MFA_Probability__c,MFA_Forecast_Unit_Price__c,MFA_Total_Forecast_QTY__c, MFA_Total_Forecast__c,MFA_Average_Selling_Price__c, MFA_Backlog_To_Date__c, MFA_Additional_Demand__c, MFA_Backlog_To_Date_QTY__c, MFA_Additional_Demand_QTY__c, MFA_Actual_Sales_QTY__c, MFA_Past_Period__c, MFA_Year__c, MFACPID__r.Name FROM Monthly_Forecast_Analysis__c where MFACPID__r.Id = '"+ strId +"' and MFA_Past_Period__c = true order by MFA_Year__c desc LIMIT 50",callbackPowT);

	
		function formatCurrency(num) 
		{
			num = num.toString().replace(/\$|\,/g,'');
			if(isNaN(num))
			num = "0";
			sign = (num == (num = Math.abs(num)));
			num = Math.floor(num*100+0.50000000001);
			cents = num%100;
			num = Math.floor(num/100).toString();
			if(cents<10)
			cents = "0" + cents;
			for (var i = 0; i < Math.floor((num.length-(1+i))/3); i++)
			num = num.substring(0,num.length-(4*i+3))+','+
			num.substring(num.length-(4*i+3));
			return (((sign)?'':'-') + '$' + num + '.' + cents);
		}
	
		function formatNumber(num) 
		{
			num = num.toString().replace(/\$|\,/g,'');
			if(isNaN(num))
			num = "0";
			sign = (num == (num = Math.abs(num)));
			num = Math.floor(num*100+0.50000000001);
			cents = num%100;
			num = Math.floor(num/100).toString();
			if(cents<10)
			cents = "0" + cents;
			for (var i = 0; i < Math.floor((num.length-(1+i))/3); i++)
			num = num.substring(0,num.length-(4*i+3))+','+
			num.substring(num.length-(4*i+3));
			return (((sign)?'':'-') + num);
		}

		function formatCurrencyNoSign(num) 
		{
			num = num.toString().replace(/\$|\,/g,'');
			if(isNaN(num))
			num = "0";
			sign = (num == (num = Math.abs(num)));
			num = Math.floor(num*100+0.50000000001);
			cents = num%100;
			num = Math.floor(num/100).toString();
			if(cents<10)
			cents = "0" + cents;
			for (var i = 0; i < Math.floor((num.length-(1+i))/3); i++)
			//num = num.substring(0,num.length-(4*i+3))+','+
			num = num.substring(0,num.length-(4*i+3))+
			num.substring(num.length-(4*i+3));
			return (((sign)?'':'-') + num + '.' + cents);
		}
		
		//probability function to pre-populate the correct values
		
		function probPopulate(probper)
		{
			var hold = probper;
			var v1,v2,v3,v4,v5,v6;
			
			v1=100;
			v2=90;
			v3=80;
			v4=70;
			v5=60;
			v6=50;
			
			if (v1==hold)
			{
				var probstring = "<OPTION selected VALUE='"+ v1 + "'>"+ v1 + "</OPTION><OPTION VALUE='"+ v2 + "'>"+ v2 + "</OPTION><OPTION VALUE='"+ v3 + "'>"+ v3 + "</OPTION><OPTION VALUE='"+ v4 + "'>"+ v4 + "</OPTION><OPTION VALUE='"+ v5 + "'>"+ v5 + "</OPTION><OPTION VALUE='"+ v6 + "'>"+ v6 + "</OPTION>";
				
				return probstring; 
			}
			
			if (v2==hold)
			{
				var probstring = "<OPTION VALUE='"+ v1 + "'>"+ v1 + "</OPTION><OPTION selected VALUE='"+ v2 + "'>"+ v2 + "</OPTION><OPTION VALUE='"+ v3 + "'>"+ v3 + "</OPTION><OPTION VALUE='"+ v4 + "'>"+ v4 + "</OPTION><OPTION VALUE='"+ v5 + "'>"+ v5 + "</OPTION><OPTION VALUE='"+ v6 + "'>"+ v6 + "</OPTION>";
				
				return probstring; 
			}
			
			if (v3==hold)
			{
				var probstring = "<OPTION VALUE='"+ v1 + "'>"+ v1 + "</OPTION><OPTION VALUE='"+ v2 + "'>"+ v2 + "</OPTION><OPTION selected VALUE='"+ v3 + "'>"+ v3 + "</OPTION><OPTION VALUE='"+ v4 + "'>"+ v4 + "</OPTION><OPTION VALUE='"+ v5 + "'>"+ v5 + "</OPTION><OPTION VALUE='"+ v6 + "'>"+ v6 + "</OPTION>";
				
				return probstring; 
			}
			
			if (v4==hold)
			{
				var probstring = "<OPTION VALUE='"+ v1 + "'>"+ v1 + "</OPTION><OPTION VALUE='"+ v2 + "'>"+ v2 + "</OPTION><OPTION VALUE='"+ v3 + "'>"+ v3 + "</OPTION><OPTION selected VALUE='"+ v4 + "'>"+ v4 + "</OPTION><OPTION VALUE='"+ v5 + "'>"+ v5 + "</OPTION><OPTION VALUE='"+ v6 + "'>"+ v6 + "</OPTION>";
				
				return probstring; 
			}
			
			if (v5==hold)
			{
				var probstring = "<OPTION VALUE='"+ v1 + "'>"+ v1 + "</OPTION><OPTION VALUE='"+ v2 + "'>"+ v2 + "</OPTION><OPTION VALUE='"+ v3 + "'>"+ v3 + "</OPTION><OPTION VALUE='"+ v4 + "'>"+ v4 + "</OPTION><OPTION selected VALUE='"+ v5 + "'>"+ v5 + "</OPTION><OPTION VALUE='"+ v6 + "'>"+ v6 + "</OPTION>";
				
				return probstring; 
			}
			
			if (v6==hold)
			{
				var probstring = "<OPTION VALUE='"+ v1 + "'>"+ v1 + "</OPTION><OPTION VALUE='"+ v2 + "'>"+ v2 + "</OPTION><OPTION VALUE='"+ v3 + "'>"+ v3 + "</OPTION><OPTION VALUE='"+ v4 + "'>"+ v4 + "</OPTION><OPTION VALUE='"+ v5 + "'>"+ v5 + "</OPTION><OPTION selected VALUE='"+ v6 + "'>"+ v6 + "</OPTION>";
				
				return probstring; 
			}
		}

		//Heart of the page. This function creates table with editable columns.
		
		function displayResultPow(result) 
		{
		
			var outputpow = "<form id=frmTop name=frmTop method=post action=''>";
			outputpow += " <table title = Months width='100%' class=list border='0' cellspacing='0' cellpading='0'>";
			
			if (sta ==undefined)
			{
				sta="";
			}
			
			if (pnum ==undefined)
			{
				outputpow += "<tr nowrap' align=center><B><font size=4 color=blue>Please Select product to forecast</font></B><tr>";
			}
			else
			{
			
			outputpow += "<tr nowrap' align=left><td><input class=mth value=Save onclick = pki_showCells() /></td><td><input class=udlabel id=status value ='"+sta+"'></input><input type=hidden id=reqid value ='"+strId+"'></input><input type=hidden id=reqpnum value ='"+pnum+"'></input><input type=hidden id=reqcid value ='"+cid+"'></input></td><td align=right>Selected Product : <B><font size=4 color=blue>"+ unescape(pnum) +"</font></B> and Customer Name : <B><font size=3 color=blue>"+ unescape(cid) +"</font></B></td></tr>";
			
			}
			
			outputpow += " </table>";
			outputpow += " </form>";
			outputpow += "<form id=frmTable name=frmTable method=post action=''>";
			outputpow += " <table title = Months width='100%' class=list border='0' cellspacing='0' cellpading='0'>";
			outputpow += "<tr class=headerRow height=20><td><b>Month</b></td>";
			outputpow += "<td><b>Probability<BR>%</b></td>";
			outputpow += "<td align=center><b>Additional<br>Demand(QTY)</b></td>";
			outputpow += "<td align=right><b>Forecast<br>Unit Price($)</b></td>";
			outputpow += "<td align=right><b>Last Sold<BR>Price($)</b></td>";
			outputpow += "<td align=right><b>Additional<BR>Demand($)</b></td>"; 
			outputpow += "<td align=center><b>Backlog<BR>to Date(QTY)</b></td>"; 
			outputpow += "<td align=right><b>Backlog<BR>to Date($)</b></td>"; 
			outputpow += "<td align=center><b>Sales<BR>to Date(QTY)</b></td>";
			outputpow += "<td align=right><b>Sales<BR>to Date($)</b></td>";
			outputpow += "<td align=center><b>Total<BR>Forecast(QTY)</b></td>";
			outputpow += "<td align=right><b>Total<BR>Forecast($)</b></td>";
			
			
		
		  var itpow = new sforce.QueryResultIterator(result);
		  var htmlpow = [];
		  while(itpow.hasNext()) 
		  {
		    var recordpow = itpow.next();
			
				outputpow += "<tr onmouseover=hiOn(this) onmouseout=hiOff(this)>" ;				
				outputpow += "<td><input class=mth value='"+ recordpow.MFA_Month__c +"' onClick=window.open('/"+ recordpow.Id +"','_blank')></input></td>";
				outputpow += "<td nowrap'><SELECT id=prob NAME=probabilty>'"+probPopulate(recordpow.MFA_Probability__c )+"';</SELECT> </td>";
				outputpow += "<td nowrap' align=center><input type=text id=dqc class=editPrompt value = '"+formatNumber(recordpow.MFA_Additional_Demand_QTY__c)+"' size=10></input></td>";
				outputpow += "<td nowrap' align=right><input id=fupc class=editPrompt value = '"+formatCurrencyNoSign(recordpow.MFA_Forecast_Unit_Price__c)+"' size=10></input></td>";
				outputpow += "<td align=right>" + formatCurrency(recordpow.MFA_Average_Selling_Price__c) +"</td>";
				outputpow += "<td align=right>" + formatCurrency(recordpow.MFA_Additional_Demand__c) +"</td>";
				outputpow += "<td align=center>" + formatNumber(recordpow.MFA_Backlog_To_Date_QTY__c) +"</td>";
				outputpow += "<td align=right>" + formatCurrency(recordpow.MFA_Backlog_To_Date__c) +"</td>";
				outputpow += "<td align=center>" + formatNumber(recordpow.MFA_Actual_Sales_QTY__c) +"</td>";
				outputpow += "<td align=right>" + formatCurrency(recordpow.MFA_Sales_To_Date__c) +"</td>";
				outputpow += "<td align=center>" + formatNumber(recordpow.MFA_Total_Forecast_QTY__c) +"</td>";
				outputpow += "<td align=right>" + formatCurrency(recordpow.MFA_Total_Forecast__c) +"</td>";
				outputpow += "<td nowrap' align=center><input type=hidden id=recid value ='"+recordpow.Id+"'></input></td>";
				
		  }
		 outputpow += "</table>";
		 //******* SBURROW - add the form close entry
		 outputpow += " </form>"
		 //******* SBURROW - end of my mod
		 document.getElementById("outputpow-div").innerHTML = outputpow;
		
		}	
	
	//Routine for past period. This function creates the readonly and collapsable table Section 4 on the page.
	
	function displayResultPowT(result) 
		{
		
		var outputpowT = " <table title = '"+ strId +"' width='100%' class=list border='0' cellspacing='0' cellpading='0'><tr class=headerRow height=20>";
		outputpowT += "<td><b>Month</b></td>";
		outputpowT += "<td><b>Probability<BR>%</b></td>";
		outputpowT += "<td align=center><b>Additional<BR>Demand(QTY)</b></td>";
		outputpowT += "<td align=right><b>Forecast<br>Unit Price($)</b></td>";
		outputpowT += "<td align=right><b>Last Sold<BR>Price($)</b></td>";
		outputpowT += "<td align=right><b>Additional<BR>Demand($)</b></td>"; 
		outputpowT += "<td align=center><b>Backlog<BR>to Date(QTY)</b></td>"; 
		outputpowT += "<td align=right><b>Backlog<BR>to Date($)</b></td>"; 
		outputpowT += "<td align=center><b>Sales<BR>to Date(QTY)</b></td>";
		outputpowT += "<td align=right><b>Sales<BR>to Date($)</b></td>";
		outputpowT += "<td align=center><b>Total<BR>Forecast(QTY)</b></td>";
		outputpowT += "<td align=right><b>Total<BR>Forecast($)</b></td>";
		
		
		
		  var itpowT = new sforce.QueryResultIterator(result);
		  var htmlpowT = [];
		  while(itpowT.hasNext()) 
		  {
		    var recordpowT = itpowT.next();
				
				outputpowT += "<tr onmouseover=hiOn(this) onmouseout=hiOff(this)>" ;				
				
				outputpowT += "<td><input class=mth value='"+ recordpowT.MFA_Month__c +"' onClick=window.open('/"+ recordpowT.Id +"','_blank') size=50 ></input></td>";
				outputpowT += "<td>" + recordpowT.MFA_Probability__c +"</td>";
				
				outputpowT += "<td align=center>" + formatNumber(recordpowT.MFA_Additional_Demand_QTY__c) +"</td>";
				outputpowT += "<td align=right>" + formatCurrencyNoSign(recordpowT.MFA_Forecast_Unit_Price__c) +"</td>";				
				outputpowT += "<td align=right>" + formatCurrency(recordpowT.MFA_Average_Selling_Price__c) +"</td>";
				outputpowT += "<td align=right>" + formatCurrency(recordpowT.MFA_Additional_Demand__c) +"</td>";
				outputpowT += "<td align=center>" + formatNumber(recordpowT.MFA_Backlog_To_Date_QTY__c) +"</td>";
				outputpowT += "<td align=right>" + formatCurrency(recordpowT.MFA_Backlog_To_Date__c) +"</td>";
				outputpowT += "<td align=center>" + formatNumber(recordpowT.MFA_Actual_Sales_QTY__c) +"</td>";
				outputpowT += "<td align=right>" + formatCurrency(recordpowT.MFA_Sales_To_Date__c) +"</td>";		
				outputpowT += "<td align=center>" + formatNumber(recordpowT.MFA_Total_Forecast_QTY__c) +"</td>";
				outputpowT += "<td align=right>" + formatCurrency(recordpowT.MFA_Total_Forecast__c) +"</td>";				

		  }
		outputpowT += "</table>"; 
		document.getElementById("outputpowT-div").innerHTML = outputpowT;
		}
	
	}
	
