	function appdata()	
	{
		  var callback = 
			{
			    onSuccess : displayResultnew,
			    onFailure : displayError
			};
			
			var keyprod,allsp;
			
			if (document.AccountSearchForm.Included.checked==true)
				{
					keyprod="true";
				}
			else
				{
					keyprod="false";
				}
			
			if (document.AccountSearchForm.SalesPerson.value=='All')
			{
				allsp = '%';
			}
			else
			{
				allsp = "%" + document.AccountSearchForm.SalesPerson.value + "%" ;
			}
			
		  sforce.connection.query("SELECT Id,Name, Part_Description__c, CP_Include_in_Forecast__c, Sales_Rep__c, PM_Product_Number__r.Name, CP_Part_Cust_Name__r.Name,CP_Part_Cust_Name__r.Id FROM Customer_Part__c where Sales_Rep__c like '"+ allsp +"' and  CP_Part_Cust_Name__r.Name like '%" + document.AccountSearchForm.AccountName.value + "%' and  PM_Product_Number__r.Name like '%" + document.AccountSearchForm.ProductNumber.value + "%' and CP_Include_in_Forecast__c = "+ keyprod +" LIMIT 10", callback);
		  
		  npow();
	}

	function displayError(error) 
		{
			document.getElementById("ResultsHolder").innerHTML =  "oops something went wrong ... " + error;
		}

	function displayErrorPow(error) 
		{
			document.getElementById("outputpow-div").innerHTML =  "oops something went wrong ... " + error;
		}
		
	function displayErrorPowT(error) 
		{
			document.getElementById("outputpowT-div").innerHTML =  "oops something went wrong ... " + error;
		}
		
	function displayResultnew(result) 
		{
		
		var output = " <table width='100%' class=list border='1' cellspacing='0' cellpading='0'><tr class=headerRow height=20>";
		output += "<th>Product Number</th>";
		output += "<th>Part Description</th>";
		output += "<th>Customer Name</th>"; 
		output += "<th>Key ?</th>"; 
		output += "<th>Sales Rep</th>"; 
		output += "<th align=center>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Action&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</th>";
		
		  var it = new sforce.QueryResultIterator(result);
		  var html = [];
		  while(it.hasNext()) 
		  {
		    var record = it.next();
			
			output += "<tr onmouseover=hiOn(this) onmouseout=hiOff(this)>" ;				
			//output += "<td><a href=javascript:npow('" + record.Id +"')>Forecast</a></td>";				
			if (record.PM_Product_Number__r) 
			{
			  output += "<td>" + record.PM_Product_Number__r.Name  + "</td>";
		    }
			output += "<td>" + record.Part_Description__c  + "</td>";
			if (record.CP_Part_Cust_Name__r) 
			{
			  //output += "<td>" + record.CP_Part_Cust_Name__r.Name  + "</td>";
			  output += "<td><a href='/"+ record.CP_Part_Cust_Name__r.Id +"' target=_blank>" + record.CP_Part_Cust_Name__r.Name + "</a></td>";
		    }	

			//output += "<td><input TYPE=CHECKBOX NAME=maillist>" + record.CP_Include_in_Forecast__c  + "</input></td>";				
			output += "<td>" + record.CP_Include_in_Forecast__c  + "</td>";				
			output += "<td nowrap>" + record.Sales_Rep__c  + "</td>";
output += "<td><input class=btn value=Forecast onClick=npow('"+record.Id+"','"+ escape(record.PM_Product_Number__r.Name) + "','" + escape(record.CP_Part_Cust_Name__r.Name) + "')></input>&nbsp;&nbsp;<input class=btn value=View onClick=window.open('/"+ record.Id +"','_blank')></input></td>";				
			
		 }
			output += "</table>";
		  document.getElementById("ResultsHolder").innerHTML = output;
		}
	
	function saveClick(dqcval,fupcval)
	{
	alert(dqcval+','+fupcval);
	}
			
	function npow(strId,pnum,cid)
	{
	
		function setup() 
			{
				if (!sforce.connection.sessionId) 
				{
				var sid = getCookie("sid");
					if (sid) 
					{
					sforce.connection.sessionId = sid;
					} 
					else 
					{
					window.location = "/?startURL=" + window.location;
					return;
					}
				}

				displayLastUpdated();
			}

			
			dojo.require("dojo.widget.*");
			dojo.require("dojo.widget.InlineEditBox");
			dojo.require("dojo.event.*");
			dojo.require("dojo.widget.TabContainer");
			dojo.require("dojo.widget.LinkPane");
			dojo.require("dojo.widget.ContentPane");
			dojo.require("dojo.widget.LayoutContainer");	

			var currentId = null;

				function saveHandler(fieldId) 
				{
				var editable = dojo.widget.byId("Monthly_Forecast_Analysis__c." + fieldId);
				var sobj = new sforce.SObject("Monthly_Forecast_Analysis__c");
				sobj.Id = currentId;
				sobj[fieldId] = editable.text.value;
				
				sforce.connection.update([sobj],
				{onSuccess: saveSuccess, onFailure: saveFailed});
				}

				function saveSuccess(result) 
				{
					if (result[0].getBoolean("success")) 
					{
						setStatus("saved ...");
					} 
					else 
					{
						setStatus("saved failed");
					}
				}

				function saveFailed(error) 
				{
					setStatus("OOPS something went wrong " + error);
				}

				function setStatus(message) 
				{
					document.getElementById("status").innerHTML = message;
				}
				
				function displayLastUpdated() 
				{
					var dctemp2=null;
					//doSearch();
					var result = sforce.connection.query("select id from Monthly_Forecast_Analysis__c limit 1");
					if (result.getArray("records").length == 1) 
					{
					dctemp2 = display(result.getArray("records")[0].Id);
					}
					return dctemp2;
				}

				function doSearch() 
				{
					var filter = document.getElementById("search-input").value;

					sforce.connection.query("select Name,id from Monthly_Forecast_Analysis__c where Name like '" +
					filter + "%' limit 15", 
					{
						onSuccess : function(result) 
						{
						var it = new sforce.QueryResultIterator(result);
						var sb = new sforce.StringBuffer();
						while (it.hasNext()) 
						{
							var sobject = it.next();
							sb.append("<img src='/img/report.gif'/> ");
							sb.append(makeDisplayLink(sobject)).append("<br>");
						}
						document.getElementById("search.list.view").innerHTML = sb.toString();
						},
						onFailure : function (error) 
						{
						document.getElementById("search.list.view").innerHTML = "oops something went wrong " + error;
						}
					});
				}

				function display(id) 
				{
					var dctemp1;
					
					var res = sforce.connection.retrieve("MFA_Additional_Demand_QTY__c", "Monthly_Forecast_Analysis__c", [id]);
					
					var value = res[0]["MFA_Additional_Demand_QTY__c"];
					if (value === null) 
					{
					value = "<span class='editPrompt'>[MFA_Additional_Demand_QTY__c]</span>" ;
					}
					
					dctemp1 = value;
					//document.getElementById("dqc").innerHTML = value;
					currentId = id;
					
					return dctemp1;

				}
				
				
		var callbackPow = 
		{
		onSuccess : displayResultPow,
	    onFailure : displayErrorPow
		};
		
		var callbackPowT = 
			{
			onSuccess : displayResultPowT,
		    onFailure : displayErrorPowT
			};
	
	
		sforce.connection.query("SELECT Id, MFA_Sales_To_Date__c, MFA_Month__c, MFA_Probability__c,MFA_Forecast_Unit_Price__c,MFA_Total_Forecast_QTY__c, MFA_Total_Forecast__c, MFA_Average_Selling_Price__c, MFA_Backlog_To_Date__c, MFA_Additional_Demand__c, MFA_Backlog_To_Date_QTY__c, MFA_Additional_Demand_QTY__c, MFA_Actual_Sales_QTY__c, MFA_Past_Period__c, MFA_Year__c, MFACPID__r.Name FROM Monthly_Forecast_Analysis__c where MFACPID__r.Id = '"+ strId +"' and MFA_Past_Period__c = false order by MFA_Year__c desc LIMIT 50",callbackPow);
	


		sforce.connection.query("SELECT Id, MFA_Sales_To_Date__c, MFA_Month__c,MFA_Probability__c,MFA_Forecast_Unit_Price__c,MFA_Total_Forecast_QTY__c, MFA_Total_Forecast__c,MFA_Average_Selling_Price__c, MFA_Backlog_To_Date__c, MFA_Additional_Demand__c, MFA_Backlog_To_Date_QTY__c, MFA_Additional_Demand_QTY__c, MFA_Actual_Sales_QTY__c, MFA_Past_Period__c, MFA_Year__c, MFACPID__r.Name FROM Monthly_Forecast_Analysis__c where MFACPID__r.Id = '"+ strId +"' and MFA_Past_Period__c = true order by MFA_Year__c desc LIMIT 50",callbackPowT);

	
		function formatCurrency(num) 
		{
			num = num.toString().replace(/\$|\,/g,'');
			if(isNaN(num))
			num = "0";
			sign = (num == (num = Math.abs(num)));
			num = Math.floor(num*100+0.50000000001);
			cents = num%100;
			num = Math.floor(num/100).toString();
			if(cents<10)
			cents = "0" + cents;
			for (var i = 0; i < Math.floor((num.length-(1+i))/3); i++)
			num = num.substring(0,num.length-(4*i+3))+','+
			num.substring(num.length-(4*i+3));
			return (((sign)?'':'-') + '$' + num + '.' + cents);
		}
	
		function formatNumber(num) 
		{
			num = num.toString().replace(/\$|\,/g,'');
			if(isNaN(num))
			num = "0";
			sign = (num == (num = Math.abs(num)));
			num = Math.floor(num*100+0.50000000001);
			cents = num%100;
			num = Math.floor(num/100).toString();
			if(cents<10)
			cents = "0" + cents;
			for (var i = 0; i < Math.floor((num.length-(1+i))/3); i++)
			num = num.substring(0,num.length-(4*i+3))+','+
			num.substring(num.length-(4*i+3));
			return (((sign)?'':'-') + num);
		}

		function displayResultPow(result) 
		{
		
		//dojo.addOnLoad(setup);
	
		var outputpow = " <table title = Months width='100%' class=list border='1' cellspacing='0' cellpading='0'>";
		
		if (pnum ==undefined)
		{
		outputpow += "<tr><B><font size=2 color=blue>Please Select product to forecast</font></B><tr>";
		}
		else
		{
		outputpow += "<tr nowrap'>Selected Product : <B><font size=3 color=blue>"+ unescape(pnum) +"</font></B> and Customer Name : <B><font size=3 color=blue>"+ unescape(cid) +"</font></B></tr>";
		}
		
		outputpow += "<tr class=headerRow height=20><th>Month</th>";
		outputpow += "<th>Probability</th>";
		outputpow += "<th>Additional<br>Demand(QTY)</th>";
		outputpow += "<th>Forecast<br>Unit Price($)</th>";
		outputpow += "<th>Last Sold<BR>Price($)</th>";
		outputpow += "<th>Additional<BR>Demand($)</th>"; 
		outputpow += "<th>Backlog<BR>to Date(QTY)</th>"; 
		outputpow += "<th>Backlog<BR>to Date($)</th>"; 
		outputpow += "<th>Sales<BR>to Date(QTY)</th>";
		outputpow += "<th>Sales<BR>to Date($)</th>";
		outputpow += "<th>Total<BR>Forecast(QTY)</th>";
		outputpow += "<th>Total<BR>Forecast($)</th>";
		outputpow += "<th align=center>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Action&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</th>";
		
		
		  var itpow = new sforce.QueryResultIterator(result);
		  var htmlpow = [];
		  while(itpow.hasNext()) 
		  {
		    var recordpow = itpow.next();
			
			//************************************************************************Salesforce Code start************************************************************************
			/*
			function popSel()
			{	
				var describeResult = sforce.connection.describeSObject("Monthly_Forecast_Analysis__c");   
			    var fieldMap = [];
			   
			    var fields = describeResult.getArray("fields");
			    for (var i = 0; i < fields.length; i++) {
			        //alert(fields[i].name);
			        fieldMap[fields[i].name] = fields[i];
			    }

			    var fldType = fieldMap["MFA_Probability__c"];
			    var selType = prob;   
			    for (var j=0;j<fldType.picklistValues.length;j++) {
			        if (fldType.picklistValues[j].active) {
			            selType.options[j] = new Option(fldType.picklistValues[j].label, fldType.picklistValues[j].value);
			            selType.options[j].selected = recordpow.MFA_Probability__c;
						//selType.options[j].selected = (fldType.picklistValues[j].defaultValue == true);
						alert(selType.options[j]);
			        }
			    }
			} */
			//************************************************************************Salesforce Code end************************************************************************		

				outputpow += "<tr onmouseover=hiOn(this) onmouseout=hiOff(this)>" ;				
				outputpow += "<td>" + recordpow.MFA_Month__c +"</td>";
				outputpow += "<td nowrap'><SELECT id=prob NAME=probabilty><OPTION VALUE=100>100</OPTION><OPTION VALUE=90>90</OPTION><OPTION VALUE=80>80</OPTION><OPTION VALUE=70>70</OPTION><OPTION VALUE=60>60</OPTION><OPTION VALUE=50>50</OPTION></SELECT> </td>";
				outputpow += "<td nowrap' align=center><input type=text id=dqc class=editPrompt value = '"+recordpow.MFA_Additional_Demand_QTY__c+"' size=10 ></input></td>";
				outputpow += "<td nowrap' align=right><input id=fupc class=editPrompt value = '"+recordpow.MFA_Forecast_Unit_Price__c+"' size=10></input></td>";
				//outputpow += "<td><span id = MFA_Additional_Demand_QTY__c dojoType=" + dojo.widget.InlineEditBox +" ><span class='editPrompt'></span></span></td>";
				//outputpow += "<td>" + recordpow.MFA_Additional_Demand_QTY__c +"</td>";				
				outputpow += "<td align=right>" + formatCurrency(recordpow.MFA_Average_Selling_Price__c) +"</td>";
				outputpow += "<td align=right>" + formatCurrency(recordpow.MFA_Additional_Demand__c) +"</td>";
				outputpow += "<td align=center>" + formatNumber(recordpow.MFA_Backlog_To_Date_QTY__c) +"</td>";
				outputpow += "<td align=right>" + formatCurrency(recordpow.MFA_Backlog_To_Date__c) +"</td>";
				outputpow += "<td align=center>" + formatNumber(recordpow.MFA_Actual_Sales_QTY__c) +"</td>";
				outputpow += "<td align=right>" + formatCurrency(recordpow.MFA_Sales_To_Date__c) +"</td>";
				outputpow += "<td align=center>" + formatNumber(recordpow.MFA_Total_Forecast_QTY__c) +"</td>";
				outputpow += "<td align=right>" + formatCurrency(recordpow.MFA_Total_Forecast__c) +"</td>";
				//outputpow += "<td><input class=btn value=Save></input></td>";
				outputpow += "<td nowrap'><input class=btn value=Save onClick=saveClick(dqc.value,fupc.value)></input>&nbsp;&nbsp<input class=btn value=View onClick=window.open('/"+ recordpow.Id +"','_blank')></input></td>";	
		  }
		 outputpow += "</table>";
		 document.getElementById("outputpow-div").innerHTML = outputpow;
		//alert("id = " + recordpow.MFA_Additional_Demand_QTY__c + "  " "dojoType=" + InlineEditBox);
		}	
	
	function displayResultPowT(result) 
		{
		
		var outputpowT = " <table title = '"+ strId +"' width='100%' class=list border='1' cellspacing='0' cellpading='0'><tr class=headerRow height=20>";
		outputpowT += "<th>Month</th>";
		outputpowT += "<th>Probability</th>";
		outputpowT += "<th>Additional<BR>Demand(QTY)</th>";
		outputpowT += "<th>Forecast<br>Unit Price($)</th>";
		outputpowT += "<th>Last Sold<BR>Price($)</th>";
		outputpowT += "<th>Additional<BR>Demand($)</th>"; 
		outputpowT += "<th>Backlog<BR>to Date(QTY)</th>"; 
		outputpowT += "<th>Backlog<BR>to Date($)</th>"; 
		outputpowT += "<th>Sales<BR>to Date(QTY)</th>";
		outputpowT += "<th>Sales<BR>to Date($)</th>";
		outputpowT += "<th>Total<BR>Forecast(QTY)</th>";
		outputpowT += "<th>Total<BR>Forecast($)</th>";
		outputpowT += "<th>Action</th>";
		
		
		  var itpowT = new sforce.QueryResultIterator(result);
		  var htmlpowT = [];
		  while(itpowT.hasNext()) 
		  {
		    var recordpowT = itpowT.next();
				
				outputpowT += "<tr onmouseover=hiOn(this) onmouseout=hiOff(this)>" ;				
				outputpowT += "<td>" + recordpowT.MFA_Month__c +"</td>";
				outputpowT += "<td>" + recordpowT.MFA_Probability__c +"</td>";
				//outputpow += "<td><span id = " + recordpow.MFA_Additional_Demand_QTY__c +" dojoType=+ 'InlineEditBox' + ></span></td>";
				outputpowT += "<td align=center>" + recordpowT.MFA_Additional_Demand_QTY__c +"</td>";
				outputpowT += "<td align=right>" + recordpowT.MFA_Forecast_Unit_Price__c +"</td>";				
				outputpowT += "<td align=right>" + formatCurrency(recordpowT.MFA_Average_Selling_Price__c) +"</td>";
				outputpowT += "<td align=right>" + formatCurrency(recordpowT.MFA_Additional_Demand__c) +"</td>";
				outputpowT += "<td align=center>" + formatNumber(recordpowT.MFA_Backlog_To_Date_QTY__c) +"</td>";
				outputpowT += "<td align=right>" + formatCurrency(recordpowT.MFA_Backlog_To_Date__c) +"</td>";
				outputpowT += "<td align=center>" + formatNumber(recordpowT.MFA_Actual_Sales_QTY__c) +"</td>";
				outputpowT += "<td align=right>" + formatCurrency(recordpowT.MFA_Sales_To_Date__c) +"</td>";		
				outputpowT += "<td align=center>" + formatNumber(recordpowT.MFA_Total_Forecast_QTY__c) +"</td>";
				outputpowT += "<td align=right>" + formatCurrency(recordpowT.MFA_Total_Forecast__c) +"</td>";				
				//outputpowT += "<td><a href='/"+ recordpowT.Id +"' target=_blank>View</a></td>";	
				outputpowT += "<td><input class=btn value=View onClick=window.open('/"+ recordpowT.Id +"','_blank')></input></td>";	
		  }
		outputpowT += "</table>"; 
		document.getElementById("outputpowT-div").innerHTML = outputpowT;
		}
	
	}




	
