            padding-right: 15px; 
            padding-left: 15px; 
            padding-bottom: 0px; 
            padding-top: 0px;
        }
        table.external
        {
            font-size:10pt;
            border-top: #e5c130 4px solid;  /*#b4a066 Company Border Color*/
            border-right: #e5c130 2px solid;
            border-bottom: #e5c130 2px solid;
            background-color:#f1f0e6;
            border-collapse: collapse;
            width:100%;

        }
        table.example        
        {   
            font-size:100%;
            border-collapse: collapse;            
            width:100%;            
