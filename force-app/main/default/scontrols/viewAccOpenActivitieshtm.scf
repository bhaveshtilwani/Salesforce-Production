<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN" "http://www.w3.org/TR/html4/loose.dtd">
<html>
<head>
<link href="/dCSS/Theme2/default/common.css" type="text/css" rel="stylesheet" >
<style type="text/css"rel="stylesheet" >
body {
    background-repeat: repeat-x;
    background-position: left top;
    font-size: 75%;
    font-family: 'Arial', 'Helvetica', sans-serif;
    background-color: #FFF;
}
</style>
<script src="http://www.salesforce.com/services/lib/ajax/beta3.3/sforceclient.js" type="text/javascript"></script>

</script>

<script language="javascript"> 
<!--
var retUrl = "{!Account_Link}";  // where we came from
function jumpback() { window.parent.parent.location.href = retUrl; }
var listing;
var sapp = new Sforce.Application();

function pageInit() {
	sforceClient.init("{!API_Session_ID}", "{!API_Partner_Server_URL_60}");
	drawOpenActivities();
}

function drawOpenActivities () { 
	var acts = sforceClient.query("select Id,Subject,Priority,Status,ActivityDate,CreatedDate,Description from Task where AccountId = '{!Account_ID}' and IsClosed = false "); 
	if ( ! assert(acts.className =="QueryResult","could not query open tasks")) {return}
	if ( acts.size < 1 ) { 
		alert("No open activities found at this Account");
		jumpback();
		return; 
	}
	listing = document.getElementById('listing');
	assert(listing,"missing listing");
	var table = document.createElement("table");
	table.className = "list";
	table.width = "75%";
	table.border = "0";
	table.cellspacing = "0";
	table.cellpadding = "0";
	table.setAttribute("class", "detailList");
	var tbody = document.createElement("tbody");
	table.appendChild(tbody);
	//parent.hasChildren = false;
	var even = true;
	
	for( var i = 0; acts.size > i;i++ ) { 
		draw_task(acts.records[i],tbody) 
	}
	listing.appendChild(table);
}

// TODO add some formating to make this look like a normal view all list
function draw_task( task, tbody){ 
	var x; var td;
	var ll = ['Subject', 'Status','Priority',  'CreatedDate', 'ActivityDate','Description'];
	for ( var i = 0; i < ll.length; i++ ) { 
		var value = task.myget(ll[i])
		var r = makeRow();
		tbody.appendChild(r);
		
		td = document.createElement("td");
		td.setAttribute("class", "labelCol");
		td.setAttribute("width","20%");
		r.appendChild(td);
		td.appendChild(document.createTextNode(ll[i]));
		
		td = document.createElement("td");
		r.appendChild(td);
		td.appendChild(document.createTextNode( value));
	
	}

	var r = makeRow();
	tbody.appendChild(r);
	td = document.createElement("td");
	td.setAttribute("colspan","2");
    hr = document.createElement("hr");
	hr.setAttribute("size", "7px");
	hr.setAttribute("color","#4579B5");
	hr.setAttribute("width", "80%");
	hr.setAttribute("align", "left");
	r.appendChild(td);
	td.appendChild(hr);
} 

function makeRow(atts) {
	if (sapp.get_type() == Sforce.Application.Type.InternetExplorer) {
		var trTag = "<TR ";
		for (key in atts) {
			trTag += key + "=\"" + atts[key] + "\"";
		}
		trTag += ">";
		var ret = document.createElement(trTag);
	} else {
		var tr = document.createElement("TR");
		for (key in atts) {
			tr.setAttribute(key, atts[key]);
		}
		var ret = tr;
	}
	ret.active = false;
	return ret;
}

Sforce.Dynabean.prototype.myget = function(propName) { // get with a date format
	var msg;
	var ret; 
	try { 
		ret =  this.getItem(propName).value; 
	} catch (e) { 
		msg = "ERROR: Your " + this.name + " object does not contain a " + propName + " field."; 
		throw(msg);	
	} 
	// if it's a date, format a bit
	var ty = this.getItem(propName).type 
	if ( ty == "datetime" || ty == "date" ) { 
		if ( ret  ) { ret = Sforce.Util.FormatDate (ret, "yyyy-MM-dd") }
	}
	if (!ret) ret = '';
	return ret;
};
function assert(fact,msg) { if ( fact ) { return true } 
	msg = "Assert failure \n" + msg
	if (arguments.callee.caller != null) { 
		msg = msg + " in function "+ arguments.callee.caller.toString().match(/function\s+(\w+)/)[1];
	} 
	alert(msg);
	return false
} 
//--> 
</script>
</head>
<body onload="pageInit()" class="account">
	<DIV id="divSpace1" style="POSITION: relative" ms_positioning="GridLayout">
	<TABLE  name="table0" cellpadding="0" cellspacing="0" border="0">
	
	<tr>
	</tr>
	</table>
	</DIV>

	<a name="skiplink"><img src="/s.gif" height='1' width='1' alt="Content Starts Here" class="skiplink"></a>
	<div class="bPageTitle">
		<div class="ptBody secondaryPalette">
			<div class="content"><img src="/s.gif" alt="Account" class="pageTitleIcon"><h1 class="pageType noSecondHeader">View All Open Activities</h1>
				<div class="blank">&nbsp;
				</div>
			</div>
		</div>
		<div class="ptBreadcrumb">
		</div>
	</div>
	<div class="topButton"><input value="Close" class="btn" type="button" title="Ckise" onclick="javascript: jumpback()" name="done">
	</div>
<div class="bPageBlock secondaryPalette" id="ep">
<div class="pbHeader">
<div class="pbBody">
<div class="pbSubsection">
	<div id="listing" >
	</div>
</DIV>
</DIV>
</div>
</body>
</html>