<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>CaseNumber</field>
        <field>Owner</field>
        <field>CreatedDate</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>Sox_Compliance_Approver__c</name>
                <type>relatedUserField</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>Step 1</label>
        <name>Step_1</name>
    </approvalStep>
    <emailTemplate>Approval_Request/SOX_Compliance_Approval_Request</emailTemplate>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>Case.RecordType</field>
            <operation>equals</operation>
            <value>SOX Order Compliance</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>SOX_Approved</name>
            <type>Alert</type>
        </action>
        <action>
            <name>SOX_Approved</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>SOXASTAT_Approved</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>true</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>SOX_Rejected</name>
            <type>Alert</type>
        </action>
        <action>
            <name>SOX_Rejected</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>SOXASTAT_Rejected</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Sox_Approval_Sent</name>
            <type>Alert</type>
        </action>
        <action>
            <name>SOX_Pending</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>SOXASTAT_Pending</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>SOX Compliance Approval Process</label>
    <processOrder>3</processOrder>
    <recallActions>
        <action>
            <name>SOX_Recalled</name>
            <type>Alert</type>
        </action>
        <action>
            <name>SOX_Recalled</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>SOXASTAT_Pending</name>
            <type>FieldUpdate</type>
        </action>
    </recallActions>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
