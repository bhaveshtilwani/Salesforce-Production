<?xml version="1.0" encoding="UTF-8"?>
<AssignmentRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <assignmentRule>
        <fullName>Case Assignment Rules</fullName>
        <active>false</active>
        <ruleEntry>
            <assignedTo>Pilot_Case_Queue</assignedTo>
            <assignedToType>Queue</assignedToType>
            <criteriaItems>
                <field>Case.Type</field>
                <operation>equals</operation>
                <value>Pilot Feedback</value>
            </criteriaItems>
        </ruleEntry>
    </assignmentRule>
    <assignmentRule>
        <fullName>Internal Support Queue</fullName>
        <active>false</active>
        <ruleEntry>
            <assignedTo>salesforce.administrator@excelitas.com</assignedTo>
            <assignedToType>User</assignedToType>
            <criteriaItems>
                <field>Case.RecordTypeId</field>
                <operation>equals</operation>
                <value>internalsupport</value>
            </criteriaItems>
        </ruleEntry>
    </assignmentRule>
</AssignmentRules>
