    <rules>
        <fullName>24hr Approval Reminder</fullName>
        <active>false</active>
        <criteriaItems>
            <field>sbaa__Approval__c.sbaa__Status__c</field>
            <operation>equals</operation>
            <value>Requested</value>
        </criteriaItems>
        <description>sends 24 Approval Quote Reminder when Status stays as Requested</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
        <workflowTimeTriggers>
            <actions>
                <name>X24_Approval_Quote_Reminder</name>
                <type>Alert</type>
            </actions>
            <timeLength>1</timeLength>
            <workflowTimeTriggerUnit>Days</workflowTimeTriggerUnit>
        </workflowTimeTriggers>
    </rules>
    <rules>
