        <actions>
            <name>Alert_to_Paul_B_on_SSL_VPPL_Approvals</name>
            <type>Alert</type>
        </actions>
        <active>false</active>
        <criteriaItems>
            <field>sbaa__Approval__c.sbaa__AssignedTo__c</field>
            <operation>equals</operation>
            <value>Oliver Scheuss</value>
        </criteriaItems>
        <criteriaItems>
            <field>sbaa__Approval__c.sbaa__Status__c</field>
            <operation>equals</operation>
            <value>Requested</value>
        </criteriaItems>
        <description>When a Quote for the VPPL SSL is sent for approval, Paul B to get copy.</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
