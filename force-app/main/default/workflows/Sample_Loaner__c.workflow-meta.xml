<?xml version="1.0" encoding="UTF-8"?>
<Workflow xmlns="http://soap.sforce.com/2006/04/metadata">
    <alerts>
        <fullName>SampleLoanerDurationExpirationNotification</fullName>
        <description>Sample Loaner Duration Expiration Notification</description>
        <protected>false</protected>
        <recipients>
            <type>creator</type>
        </recipients>
        <recipients>
            <type>owner</type>
        </recipients>
        <recipients>
            <recipient>salesforce.administrator@excelitas.com</recipient>
            <type>user</type>
        </recipients>
        <senderType>CurrentUser</senderType>
        <template>JC_ALL/SampleLoanerDurationExpirationNotification</template>
    </alerts>
    <alerts>
        <fullName>Sample_Loaner_Status_Changed_to_Shipped</fullName>
        <description>Sample Loaner Status Changed to Shipped</description>
        <protected>false</protected>
        <recipients>
            <type>creator</type>
        </recipients>
        <recipients>
            <type>owner</type>
        </recipients>
        <recipients>
            <recipient>salesforce.administrator@excelitas.com</recipient>
            <type>user</type>
        </recipients>
        <senderType>CurrentUser</senderType>
        <template>JC_ALL/Sample_Loaner_Status_Changed_to_Shipped</template>
    </alerts>
    <rules>
        <fullName>Loaner Duration Notification</fullName>
        <active>false</active>
        <criteriaItems>
            <field>Sample_Loaner__c.Loaner_Due_Date__c</field>
            <operation>notEqual</operation>
        </criteriaItems>
        <criteriaItems>
            <field>Sample_Loaner__c.Status__c</field>
            <operation>equals</operation>
            <value>Shipped</value>
        </criteriaItems>
        <description>creates a Task  and sends notification 3 Days Before Sample/Loaner: Loaner Due Date</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
        <workflowTimeTriggers>
            <actions>
                <name>SampleLoanerDurationExpirationNotification</name>
                <type>Alert</type>
            </actions>
            <actions>
                <name>SampleLoanerdurationwillexpiresoon</name>
                <type>Task</type>
            </actions>
            <offsetFromField>Sample_Loaner__c.Loaner_Due_Date__c</offsetFromField>
            <timeLength>-3</timeLength>
            <workflowTimeTriggerUnit>Days</workflowTimeTriggerUnit>
        </workflowTimeTriggers>
    </rules>
    <rules>
        <fullName>SL Status Changed</fullName>
        <active>false</active>
        <criteriaItems>
            <field>Sample_Loaner__c.Status__c</field>
            <operation>equals</operation>
            <value>Approved</value>
        </criteriaItems>
        <triggerType>onAllChanges</triggerType>
    </rules>
    <rules>
        <fullName>Sample Loaner Status Changed to Shipped</fullName>
        <actions>
            <name>Sample_Loaner_Status_Changed_to_Shipped</name>
            <type>Alert</type>
        </actions>
        <active>false</active>
        <criteriaItems>
            <field>Sample_Loaner__c.Status__c</field>
            <operation>equals</operation>
            <value>Shipped</value>
        </criteriaItems>
        <description>Sample Loaner Status Changed to Shipped, email sent to the creator</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <tasks>
        <fullName>SampleLoanerdurationwillexpiresoon</fullName>
        <assignedToType>owner</assignedToType>
        <description>Please take Necessary Action.</description>
        <dueDateOffset>-15</dueDateOffset>
        <notifyAssignee>false</notifyAssignee>
        <offsetFromField>Sample_Loaner__c.Loaner_Due_Date__c</offsetFromField>
        <priority>01 - ASAP</priority>
        <protected>false</protected>
        <status>07 - In Progress</status>
        <subject>Sample / Loaner duration will expire soon.</subject>
    </tasks>
</Workflow>
