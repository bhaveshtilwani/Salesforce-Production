<?xml version="1.0" encoding="UTF-8"?>
<Workflow xmlns="http://soap.sforce.com/2006/04/metadata">
    <alerts>
        <fullName>CFIn_Notification</fullName>
        <description>CFIN Notification</description>
        <protected>false</protected>
        <recipients>
            <type>owner</type>
        </recipients>
        <senderType>CurrentUser</senderType>
        <template>JC_ALL/CFIN_Account_for_Completion_TASK</template>
    </alerts>
    <rules>
        <fullName>CFIN Task</fullName>
        <actions>
            <name>CFIn_Notification</name>
            <type>Alert</type>
        </actions>
        <active>false</active>
        <criteriaItems>
            <field>Task.Subject</field>
            <operation>equals</operation>
            <value>Account Submitted for CFIN Completion</value>
        </criteriaItems>
        <description>sends a notification on Task creation</description>
        <triggerType>onCreateOnly</triggerType>
    </rules>
</Workflow>
