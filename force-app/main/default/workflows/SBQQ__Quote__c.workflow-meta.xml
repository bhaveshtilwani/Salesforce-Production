    <rules>
        <fullName>Approved Date</fullName>
        <actions>
            <name>Approved_date</name>
            <type>FieldUpdate</type>
        </actions>
        <active>false</active>
        <criteriaItems>
            <field>SBQQ__Quote__c.SBQQ__Status__c</field>
            <operation>equals</operation>
            <value>Approved</value>
        </criteriaItems>
        <description>fills Quote Approved Date with today&apos;s date</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>Big Quote Notification</fullName>
        <actions>
            <name>VP_Sales_1M_Quote_Notification</name>
            <type>Alert</type>
        </actions>
        <active>false</active>
        <booleanFilter>1 AND (2 OR 3)</booleanFilter>
        <criteriaItems>
            <field>SBQQ__Quote__c.SubmittedDate__c</field>
            <operation>equals</operation>
            <value>TODAY</value>
        </criteriaItems>
        <criteriaItems>
            <field>SBQQ__Quote__c.SBQQ__CustomerAmount__c</field>
            <operation>greaterThan</operation>
            <value>&quot;USD 1,000,000&quot;</value>
        </criteriaItems>
        <criteriaItems>
            <field>SBQQ__Quote__c.Max_Quote_Value__c</field>
            <operation>greaterThan</operation>
            <value>&quot;USD 1,000,000&quot;</value>
        </criteriaItems>
        <description>When a Quote &gt;1,000,000.00 is approved, notification sent to VP Sales</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>Big Quote Notification - Rep TeamVP</fullName>
        <actions>
            <name>Team_VP_100K_Quote_Notification</name>
            <type>Alert</type>
        </actions>
        <active>false</active>
        <booleanFilter>1 AND (2 OR 3)</booleanFilter>
        <criteriaItems>
            <field>SBQQ__Quote__c.SubmittedDate__c</field>
            <operation>equals</operation>
            <value>TODAY</value>
        </criteriaItems>
        <criteriaItems>
            <field>SBQQ__Quote__c.SBQQ__CustomerAmount__c</field>
            <operation>greaterOrEqual</operation>
            <value>&quot;USD 100,000&quot;</value>
        </criteriaItems>
        <criteriaItems>
            <field>SBQQ__Quote__c.Max_Quote_Value__c</field>
            <operation>greaterOrEqual</operation>
            <value>&quot;USD 100,000&quot;</value>
        </criteriaItems>
        <description>When a Quote &gt;100,000.00 is approved, notification sent to Team VP</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>Big Quote Notification D%26A</fullName>
        <actions>
            <name>Big_Quote_Alert_D_A</name>
            <type>Alert</type>
        </actions>
        <active>false</active>
        <booleanFilter>((1 AND 4 and 2) OR 3)</booleanFilter>
        <criteriaItems>
            <field>SBQQ__Quote__c.SubmittedDate__c</field>
            <operation>equals</operation>
            <value>TODAY</value>
        </criteriaItems>
        <criteriaItems>
            <field>SBQQ__Quote__c.SBQQ__CustomerAmount__c</field>
            <operation>greaterThan</operation>
            <value>&quot;USD 1,000,000&quot;</value>
        </criteriaItems>
        <criteriaItems>
            <field>SBQQ__Quote__c.Max_Quote_Value__c</field>
            <operation>greaterThan</operation>
            <value>&quot;USD 1,000,000&quot;</value>
        </criteriaItems>
        <criteriaItems>
            <field>User.Sales_TeamNEW__c</field>
            <operation>equals</operation>
            <value>AO</value>
        </criteriaItems>
        <description>When a Quote &gt;1,000,000.00 is sent for approval, notification sent to D&amp;A VP Sales Ed Y.</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>CPQU__CPQU - Draft Quote %3D Watermark</fullName>
        <actions>
            <name>CPQU__Watermark_true</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <formula>TEXT(SBQQ__Status__c) == &quot;Draft&quot; &amp;&amp;  $Setup.CPQU__Settings__c.CPQU__Show_Watermark_on_Draft_Quotes__c</formula>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>CPQU__CPQU - Non-Draft Quote %3D No Watermark</fullName>
        <actions>
            <name>CPQU__Watermark_false</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <formula>TEXT(SBQQ__Status__c) &lt;&gt; &quot;Draft&quot; &amp;&amp; $Setup.CPQU__Settings__c.CPQU__Show_Watermark_on_Draft_Quotes__c</formula>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>Submit Date Stamp</fullName>
        <actions>
            <name>Submited_Date_Stamp</name>
            <type>FieldUpdate</type>
        </actions>
        <active>false</active>
        <criteriaItems>
            <field>SBQQ__Quote__c.SBQQ__Status__c</field>
            <operation>equals</operation>
            <value>In Review</value>
        </criteriaItems>
        <description>Fills Quote Submit date with today&apos;s date when Status is moved to In Review</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
</Workflow>
