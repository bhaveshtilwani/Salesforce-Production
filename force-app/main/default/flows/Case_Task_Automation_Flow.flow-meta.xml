<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Decision_3</name>
        <label>check status</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Outcome_1_of_Decision_3</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Final Processing</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Copy_1_of_Create_Technical_Task</targetReference>
            </connector>
            <label>Final Processing Status</label>
        </rules>
    </decisions>
    <decisions>
        <name>If_task_is_ownerid_is_equal_to_case_ownerid</name>
        <label>If task is ownerid is equal to case ownerid</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Owner_already_has_a_task</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Task_Record.OwnerId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.OwnerId</elementReference>
                </rightValue>
            </conditions>
            <label>Owner already has a task</label>
        </rules>
        <rules>
            <name>Task_ownerid_is_not_equal_to_TR_id</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Final Processing</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.OwnerId</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record.OwnerId</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Technical_Task</targetReference>
            </connector>
            <label>Task ownerid is not equal to TR id</label>
        </rules>
    </decisions>
    <decisions>
        <name>Task_Exist_or_not</name>
        <label>Task Exist or not</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Decision_3</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Task_Record</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>If_task_is_ownerid_is_equal_to_case_ownerid</targetReference>
            </connector>
            <label>If Yes</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>Cleancasedescription</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE(
    SUBSTITUTE(
        {!casedescription},
        &quot;&lt;p&gt;&quot;,
        &quot;&quot;
    ),
    &quot;&lt;/p&gt;&quot;,
    &quot;&quot;
)</expression>
    </formulas>
    <formulas>
        <name>formula</name>
        <dataType>DateTime</dataType>
        <expression>{!$Record.CreatedDate}+3</expression>
    </formulas>
    <interviewLabel>Case Task Automation Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Case Task Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
