    <description>Revert Change related to AE Comments
#INC-275551 Leads - internal and customer comments updated
#INC-276925 Leads - stop re-assigning to Scott</description>
    <environments>Default</environments>
    <formulas>
        <name>didNotAttend</name>
        <dataType>Boolean</dataType>
        <expression>OR(
  CONTAINS(LOWER({!$Record.Notes__c}), &quot;did not attend&quot;),
  CONTAINS(LOWER({!$Record.Notes__c}), &quot;not attend&quot;)
)</expression>
    </formulas>
    <formulas>
        <name>New_AccountEngagementComment</name>
        <dataType>String</dataType>
        <expression>TRIM(
    SUBSTITUTE(
        $Record.pi__comments__c,
        &apos;202&apos;,
        BR() &amp; &apos;202&apos;
    )
)</expression>
    </formulas>
    <formulas>
        <name>New_iCaptureComment</name>
        <dataType>String</dataType>
        <expression>IF(
    ISBLANK({!$Record__Prior.iCapture_Comments__c}),
    /* first time, nothing to stack */
    {!$Record.iCapture_Comments__c},
    /* else: new on top, old below */
    {!$Record.iCapture_Comments__c} &amp;
    BR() &amp;
    {!$Record__Prior.iCapture_Comments__c}
)</expression>
    </formulas>
    <formulas>
        <name>New_NotesMarketingComment</name>
        <dataType>String</dataType>
        <expression>IF(
    ISBLANK({!$Record__Prior.Notes__c}),
    /* first time, nothing to stack */
    {!$Record.Notes__c},
    /* else: new on top, old below */
    {!$Record.Notes__c} &amp;
    BR() &amp;
    {!$Record__Prior.Notes__c}
)</expression>
    </formulas>
    <formulas>
        <name>NewLeadCriteria</name>
        <dataType>Boolean</dataType>
        <expression>AND (
ISNEW() ,  ISPICKVAL({!$Record.Status}, &apos;Open&apos;)
)</expression>
    </formulas>
    <formulas>
        <name>ReassignedLeadCriteria</name>
        <dataType>Boolean</dataType>
        <expression>AND  (ISCHANGED({!$Record.OwnerId}) , BEGINS({!$Record.OwnerId}, &apos;005&apos;))</expression>
    </formulas>
    <formulas>
        <name>statusValue</name>
        <dataType>String</dataType>
        <expression>IF(
  ISPICKVAL({!$Record.Status}, &quot;Closed&quot;),
  &quot;Open&quot;,
  TEXT({!$Record.Status})
)</expression>
    </formulas>
    <formulas>
        <name>Today</name>
        <dataType>Date</dataType>
        <expression>TODAY()</expression>
    </formulas>
    <formulas>
        <name>varNow</name>
        <dataType>DateTime</dataType>
        <expression>NOW()</expression>
    </formulas>
    <formulas>
        <name>varToday</name>
        <dataType>Date</dataType>
        <expression>TODAY()</expression>
    </formulas>
