    <textTemplates>
        <name>Email_Body_Calibration_ActionCompleted</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;Please be advised that the status of the case number below has been updated to “Action completed - ready to ship back to customer”, and that a Sales Order can now be created for the product to be shipped.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Case Number&lt;/strong&gt;: &lt;a href=&quot;{!RecordURL}&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;{!$Record.CaseNumber}&lt;/a&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Record Type&lt;/strong&gt;: {!$Record.RecordType.Name}&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Case Type:&lt;/strong&gt; {!$Record.Type}&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Case Status:&lt;/strong&gt; {!$Record.Status}&lt;/p&gt;</text>
    </textTemplates>
