    <recordUpdates>
        <description>Update Related Contact</description>
        <name>Update_Order</name>
        <label>Update Order</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Contact_Email__c</field>
