    <decisions>
        <description>Indicates whether the bypass mechanism is active for this process. When enabled, certain validations or automation rules are skipped to allow exceptional processing or troubleshooting scenarios</description>
        <name>If_Bypass_Enabled</name>
        <label>If Bypass Enabled?</label>
        <locationX>176</locationX>
        <locationY>395</locationY>
        <defaultConnector>
            <targetReference>When_quantity_and_reason_code_type</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_Enabled</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Bypass_Record.Bypass_Flow_c__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>If Enabled</label>
        </rules>
    </decisions>
    <decisions>
        <description>Run when Quantity = 0 and Reason Code is not null.</description>
        <name>When_quantity_and_reason_code_type</name>
        <label>When quantity and reason code type</label>
        <locationX>374</locationX>
        <locationY>503</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>if_yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Quantity</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Is_Reason_Code_Not_Blank</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>update_rejection_code</targetReference>
            </connector>
            <label>if yes</label>
        </rules>
    </decisions>
    <description>When Order Item Quantity is &quot;ZERO&quot; and &apos;Reason Code&apos; is &apos;not null&apos;, update the Order Product’s &quot;Reason for Rejection&quot; with the related &apos;Rejection Code&apos;.</description>
    <environments>Default</environments>
    <formulas>
        <name>Is_Reason_Code_Not_Blank</name>
        <dataType>Boolean</dataType>
        <expression>NOT(ISBLANK({!$Record.Order.Excelitas_Site__r.Reason_Code__c}))</expression>
    </formulas>
