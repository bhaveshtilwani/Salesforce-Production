        </connector>
        <inputAssignments>
            <field>SR_Qty_Req__c</field>
            <value>
                <elementReference>$Record.SBQQ__Quantity__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>SR_Sold_to_Price__c</field>
            <value>
                <elementReference>$Record.SBQQ__ListPrice__c</elementReference>
            </value>
        </inputAssignments>
