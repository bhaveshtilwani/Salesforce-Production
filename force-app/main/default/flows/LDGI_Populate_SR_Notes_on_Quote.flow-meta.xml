    <decisions>
        <name>SR_Note_has_value</name>
        <label>SR Note has value</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Update_Quote_SR</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Value</defaultConnectorLabel>
        <rules>
            <name>With_Value</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Check_Quote.SR_NoteLONG__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <label>With Value</label>
        </rules>
    </decisions>
    <decisions>
        <name>SR_Type</name>
        <label>SR Type</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Check_Quote</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Non_Inventory_Types</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.SR_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>SR-NRE</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.SR_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>SR-NRE Tooling</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.SR_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>SR-Testing</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.SR_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>SR-Regulatory</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Non_Inventory_Checkbox</targetReference>
            </connector>
            <label>Non Inventory Types</label>
        </rules>
    </decisions>
    <environments>Default</environments>
