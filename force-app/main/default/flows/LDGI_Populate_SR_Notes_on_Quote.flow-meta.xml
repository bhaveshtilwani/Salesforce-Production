            <targetReference>Check_Quote</targetReference>
        </connector>
        <inputAssignments>
            <field>Non_InventoryLDGI__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Push_Quantity_and_Price</name>
