    <description>To send the email and bell notifications to group members when the group is mentioned in the chatter post</description>
    <environments>Default</environments>
    <formulas>
        <name>checkFeedItemBody</name>
        <dataType>Boolean</dataType>
        <expression>CONTAINS({!$Record.Body}, &apos;@Sales EMEA&apos;)</expression>
    </formulas>
    <formulas>
        <name>SanititzedFeedItemBody</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE(SUBSTITUTE({!$Record.Body}, &quot;&lt;p&gt;&quot;, &quot;&quot;), &quot;&lt;/p&gt;&quot;, &quot;&quot;)</expression>
    </formulas>
