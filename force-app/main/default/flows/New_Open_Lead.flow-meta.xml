            <field>Lead_Source_Date__c</field>
            <value>
                <elementReference>Today</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>179</locationX>
        <locationY>50</locationY>
        <connector>
            <targetReference>Get_Queue_Records</targetReference>
        </connector>
        <filterFormula>AND(
    ISPICKVAL({!$Record.Status}, &apos;Open&apos;),
    ISNEW()
)</filterFormula>
        <object>Lead</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
