    <description>Additional Leads Added - Update Fixed Notif (Direct)</description>
    <environments>Default</environments>
    <formulas>
        <name>Subject</name>
        <dataType>String</dataType>
        <expression>&quot;New Lead In Queue - &quot; &amp; {!$Record.Company}</expression>
    </formulas>
    <formulas>
        <name>Today</name>
        <dataType>Date</dataType>
        <expression>TODAY()</expression>
    </formulas>
    <interviewLabel>New Open Lead {!$Flow.CurrentDateTime}</interviewLabel>
    <label>New Open Lead</label>
