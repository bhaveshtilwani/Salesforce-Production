<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Copy_Remarks_from_related_account</name>
        <label>Copy Remarks from related account</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Remarks__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Bill_To_Account__r.Remarks__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Check_If_Order_Should_Be_Closed</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Order_Status_To_Closed</name>
        <label>Set Order Status To Closed</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.ERP_Order_Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Order Completed</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.QAD_Sales_Order_Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Closed</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Close_Date__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>EffectiveCloseDate</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.IsOverride__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Check_If_Order_Should_Be_Closed</name>
        <label>Check If Order Should Be Closed</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_condition_met</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Total_Invoice_Count__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>$Record.LineItemCount__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Total_Invoice_Count__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Total_Invoiced__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Total_Line_Items_SUM__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Order_Status_To_Closed</targetReference>
            </connector>
            <label>If condition met</label>
        </rules>
    </decisions>
    <decisions>
        <name>If_remarks_is_Null</name>
        <label>If remarks is Null</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Check_If_Order_Should_Be_Closed</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>iF_Null</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Remarks__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Copy_Remarks_from_related_account</targetReference>
            </connector>
            <label>iF Null</label>
        </rules>
    </decisions>
    <description>When order remarks is empty it is populated from related sold to Account and if the total invoice count is greater the line items, then ERP order status is set to closed</description>
    <environments>Default</environments>
    <formulas>
        <name>EffectiveCloseDate</name>
        <dataType>Date</dataType>
        <expression>IF(ISBLANK({!$Record.Close_Date__c}), TODAY(), {!$Record.Close_Date__c})</expression>
    </formulas>
    <interviewLabel>Order - Close Order When Invoice Qty Meets Ordered Qty {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Order - Close Order When Invoice Qty Meets Ordered Qty update Account remarks</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>If_remarks_is_Null</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Site__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Toronto</stringValue>
            </value>
        </filters>
        <object>Order</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Draft</status>
</Flow>
