    <formulas>
        <name>cstValue2</name>
        <dataType>String</dataType>
        <expression>IF({!Copy_2_of_Product_Type} = &apos;Serial Product&apos;, {!Copy_2_of_Custom_vs_Standard}, &apos;Standard&apos;)</expression>
    </formulas>
    <formulas>
        <name>customorStandardValue</name>
        <dataType>String</dataType>
        <expression>IF({!Product_Type} = &apos;Serial Product&apos;, {!Custom_vs_Standard}, &apos;Standard&apos;)</expression>
    </formulas>
    <formulas>
        <name>isDisabledCustomSTd</name>
        <dataType>Boolean</dataType>
        <expression>IF({!Product_Type} = &apos;SERPROD&apos;, False, True)</expression>
    </formulas>
    <formulas>
        <name>revenueRecogType</name>
        <dataType>String</dataType>
        <expression>IF(
  ISPICKVAL({!orderRecord.Product_Type__c}, &quot;NRE/PTYPE&quot;),
  &quot;NRE&quot;,
  IF(
    ISPICKVAL({!orderRecord.Product_Type__c}, &quot;SERV/FEE&quot;),
    &quot;SERV&quot;,
    IF(
      AND(
        ISPICKVAL({!orderRecord.Product_Type__c}, &quot;SERPROD&quot;),
        ISPICKVAL({!orderRecord.Custom_vs_Standard__c}, &quot;Standard Terms&quot;)
      ),
      &quot;PIT&quot;,
      
      IF(
        AND(
          ISPICKVAL({!orderRecord.Product_Type__c}, &quot;SERPROD&quot;),
          ISPICKVAL({!orderRecord.Custom_vs_Standard__c}, &quot;Custom&quot;),
          ISPICKVAL({!orderRecord.Agreement_Type__c}, &quot;Standard Terms&quot;)
        ),
        &quot;OVT&quot;,
        
        IF(
          AND(
            ISPICKVAL({!orderRecord.Product_Type__c}, &quot;SERPROD&quot;),
            ISPICKVAL({!orderRecord.Custom_vs_Standard__c}, &quot;Custom&quot;),
            ISPICKVAL({!orderRecord.Agreement_Type__c}, &quot;Negotiated Agreement&quot;),
            ISPICKVAL({!orderRecord.RighttoCostProfitUpon_Cancellation__c}, &quot;Yes&quot;)
          ),
          &quot;OVT&quot;,
          
          IF(
            AND(
              ISPICKVAL({!orderRecord.Product_Type__c}, &quot;SERPROD&quot;),
              ISPICKVAL({!orderRecord.Custom_vs_Standard__c}, &quot;Custom&quot;),
              ISPICKVAL({!orderRecord.Agreement_Type__c}, &quot;Negotiated Agreement&quot;),
              ISPICKVAL({!orderRecord.RighttoCostProfitUpon_Cancellation__c}, &quot;No&quot;)
            ),
            &quot;PIT&quot;,
            
            &quot;&quot;
          )
        )
      )
    )
  )
)</expression>
    </formulas>
