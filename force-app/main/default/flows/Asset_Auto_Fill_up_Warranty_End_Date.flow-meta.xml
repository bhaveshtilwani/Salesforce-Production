<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description>Check whether the product is active or Inactive with the OBS Status of the product reference.</description>
        <name>Check_For_Asset_Inactive_Product_Reference</name>
        <label>Check For Asset Inactive Product Reference</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Inactive</defaultConnectorLabel>
        <rules>
            <name>Active_OR_Inactive_With_OBS</name>
            <conditionLogic>1 OR (2 AND 3)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Product2.IsActive</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Product2.IsActive</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Product2.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>OBS</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_For_Insert_Update_Record_For_purchase_Date</targetReference>
            </connector>
            <label>Active OR Inactive With OBS</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_For_Insert_Update_For_Account</name>
        <label>Check For Insert &amp; Update For Account</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>For_Account_Insert_Update</name>
            <conditionLogic>(1 AND 3) OR 2</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior.AccountId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.AccountId</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.AccountId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Asset_Account_Text</targetReference>
            </connector>
            <label>For Account Insert &amp; Update</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_For_Insert_Update_Record_For_purchase_Date</name>
        <label>Check For Insert &amp; Update Record For purchase Date</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Check_For_Insert_Update_For_Account</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>For_Insert_OR_Update_Purchase_Date</name>
            <conditionLogic>(1 AND 2) OR (2 AND 3)</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior.PurchaseDate</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PurchaseDate</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.PurchaseDate</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.PurchaseDate</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Asset_Warranty_End_Date</targetReference>
            </connector>
            <label>For Insert OR Update Purchase Date</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <description>Calculate Original Warranty End Date Based on the Asset Purchase Date</description>
        <name>CalculateOriginalWED</name>
        <dataType>Date</dataType>
        <expression>{!$Record.PurchaseDate} + 365</expression>
    </formulas>
    <interviewLabel>Asset - Auto Fill up Warranty End Date {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Asset - Auto Fill up Warranty End Date</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <description>When any account lookup reference change on the Asset tehn account text value chamge on insert &amp; update scenario.</description>
        <name>Update_Asset_Account_Text</name>
        <label>Update Asset Account Text</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Account__c</field>
            <value>
                <elementReference>$Record.Account.Name</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <description>Update Asset Record Warranty End Date</description>
        <name>Update_Asset_Warranty_End_Date</name>
        <label>Update Asset Warranty End Date</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_For_Insert_Update_For_Account</targetReference>
        </connector>
        <inputAssignments>
            <field>UsageEndDate__c</field>
            <value>
                <elementReference>CalculateOriginalWED</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_For_Asset_Inactive_Product_Reference</targetReference>
        </connector>
        <filterLogic>or</filterLogic>
        <filters>
            <field>PurchaseDate</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>PurchaseDate</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>AccountId</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>AccountId</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Asset</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
