<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description>bypass when enable</description>
        <name>Is_Bypass_Enable</name>
        <label>Is Bypass Enable?</label>
        <locationX>176</locationX>
        <locationY>431</locationY>
        <defaultConnector>
            <targetReference>Update_Total_Price</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_enable</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Bypass_Record.Bypass_Flow_c__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>Is enable</label>
        </rules>
    </decisions>
    <description>When the Order Product field &apos;Quantity&apos; is greater than 0 and &apos;UI Price Editable&apos; is False, update the field &apos;Total Price&apos; as &apos;Quantity&apos; × &apos;Unit Price&apos;.</description>
    <environments>Default</environments>
    <formulas>
        <name>Set_Order_TotalFormula</name>
        <dataType>Currency</dataType>
        <expression>$Record.Quantity  *  $Record.UnitPrice</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>Set Order Total {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Set Order Total</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <description>It Creates Flow Error Logs Records</description>
        <name>Create_Flow_Error_Logs_Records</name>
        <label>Create Flow Error Logs Records</label>
        <locationX>572</locationX>
        <locationY>647</locationY>
        <inputAssignments>
            <field>Error_Message__c</field>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>FLOW_API_NAME__c</field>
            <value>
                <stringValue>Set_Order_Total_Flow</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Record_ID__c</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Timestamp__c</field>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>User_Name__c</field>
            <value>
                <elementReference>$User.Username</elementReference>
            </value>
        </inputAssignments>
        <object>Flow_Error_Log__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <description>Get Bypass Record for bypass when mass uplaod</description>
        <name>Get_Bypass_Record</name>
        <label>Get Bypass Record</label>
        <locationX>176</locationX>
        <locationY>323</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Is_Bypass_Enable</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Order_Product_Bypass</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Flow_Bypass__mdt</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <description>Update Total Price on Quantity and Unit Price</description>
        <name>Update_Total_Price</name>
        <label>Update Total Price</label>
        <locationX>308</locationX>
        <locationY>539</locationY>
        <faultConnector>
            <targetReference>Create_Flow_Error_Logs_Records</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>Total_Price__c</field>
            <value>
                <elementReference>Set_Order_TotalFormula</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Bypass_Record</targetReference>
        </connector>
        <filterLogic>(1 AND 2) AND (3 AND 4 AND 5)</filterLogic>
        <filters>
            <field>Quantity</field>
            <operator>GreaterThan</operator>
            <value>
                <numberValue>0.0</numberValue>
            </value>
        </filters>
        <filters>
            <field>UI_Price_Editable__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Site__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>ESG L&amp;D</stringValue>
            </value>
        </filters>
        <filters>
            <field>Site__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>ESG Optics</stringValue>
            </value>
        </filters>
        <filters>
            <field>Site__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Shenzhen</stringValue>
            </value>
        </filters>
        <object>OrderItem</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
