        </defaultConnector>
        <defaultConnectorLabel>FALSE_Quote Line ITC Approval</defaultConnectorLabel>
        <rules>
            <name>TRUE_Quote_Line_ITC_Approval</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.ITC_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>ITC Rejected</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.ITC_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Needs ITC Approval</stringValue>
                </rightValue>
            </conditions>
            <connector>
