    <formulas>
        <name>Excelitas_Site_Country_Text</name>
        <dataType>String</dataType>
        <expression>IF(
   NOT(ISBLANK({!$Record.Excelitas_Site__c})), 
   TEXT({!$Record.Excelitas_Site__r.Site_Country__c}), 
   NULL
)</expression>
