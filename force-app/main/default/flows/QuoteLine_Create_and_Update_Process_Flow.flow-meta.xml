    <decisions>
        <description>Checks if the related Quote’s Approval Status is Approved, Quote Approved on the Quote Line is True, and the Quote Approved field has changed. If all are true, the Flow proceeds.</description>
        <name>Quote_is_Approved</name>
        <label>Quote is Approved</label>
        <locationX>550</locationX>
        <locationY>3155</locationY>
        <defaultConnectorLabel>FALSE_Quote is Approved</defaultConnectorLabel>
        <rules>
            <name>TRUE_Quote_is_Approved</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.SBQQ__Quote__r.ApprovalStatus__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approved</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Quote_Approved__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Quote_Approved__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Approved_values</targetReference>
            </connector>
            <label>TRUE_Quote is Approved</label>
        </rules>
    </decisions>
    <decisions>
        <description>Checks if ITC Status on the Quote Line equals ITC Rejected or Needs ITC Approval. If true, the Flow proceeds.</description>
        <name>Quote_Line_ITC_Approval</name>
