    <description>QAD Toronto Update</description>
    <environments>Default</environments>
    <formulas>
        <name>FinalUnitPrice</name>
        <dataType>Number</dataType>
        <expression>{!$Record.UnitPrice} 
* (1 - BLANKVALUE({!$Record.Discount_1__c}, 0) / 100) 
* (1 - BLANKVALUE({!$Record.Discount_2__c}, 0) / 100) 
* (1 - BLANKVALUE({!$Record.Discount_3__c}, 0) / 100)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>FormattedPrice</name>
        <dataType>String</dataType>
        <expression>TEXT( ROUND( {!FinalUnitPrice} , 2 ) )</expression>
    </formulas>
    <formulas>
        <name>QAD_Comment_Value</name>
        <dataType>String</dataType>
        <expression>&quot;CV$&quot; &amp; {!FormattedPrice} &amp; &quot; &quot; &amp; BLANKVALUE(TEXT({!$Record.CurrencyIsoCode}), &quot;USD&quot;)</expression>
    </formulas>
    <formulas>
        <name>QAD_DiscountZero_Value</name>
        <dataType>String</dataType>
        <expression>&quot;CV$0.00 &quot; &amp; BLANKVALUE(TEXT({!$Record.CurrencyIsoCode}), &quot;USD&quot;)</expression>
    </formulas>
