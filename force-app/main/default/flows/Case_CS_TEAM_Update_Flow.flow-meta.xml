    <decisions>
        <description>Check current user&apos;s CS-Team and update the case CS-Team field.</description>
        <name>Check_Current_User_s_CS_Team</name>
        <label>Check Current User&apos;s CS-Team</label>
        <locationX>578</locationX>
        <locationY>611</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>CS_AMER</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Current_User.CS_Team__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>CS AMER</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Case_s_CS_Team_to_CS_AMER</targetReference>
            </connector>
            <label>CS AMER</label>
        </rules>
        <rules>
            <name>CS_ASIA</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Current_User.CS_Team__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>CS ASIA</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Case_s_CS_Team_to_CS_ASIA</targetReference>
            </connector>
            <label>CS ASIA</label>
        </rules>
        <rules>
            <name>CS_EMEA</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Current_User.CS_Team__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>CS EMEA</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Case_s_CS_Team_to_CS_EMEA</targetReference>
            </connector>
            <label>CS EMEA</label>
        </rules>
        <rules>
            <name>CS_ADMIN</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Current_User.CS_Team__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>CS ADMIN</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Case_s_CS_Team_to_CS_ADMIN</targetReference>
            </connector>
            <label>CS ADMIN</label>
        </rules>
    </decisions>
    <decisions>
        <description>Check bypass flag is enabled to prevent flow processing.</description>
        <name>Is_Bypass_Enabled</name>
        <label>Is Bypass Enabled?</label>
        <locationX>182</locationX>
        <locationY>395</locationY>
        <defaultConnector>
            <targetReference>Get_Current_User</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Bypass_Is_True</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Bypass_Record.Bypass_Flow_c__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>Bypass Is True</label>
        </rules>
    </decisions>
    <description>Update the Case ‘CS-Team’ field with the value from the logged-in User’s ‘CS-Team’ field.</description>
