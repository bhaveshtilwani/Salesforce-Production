    <description>Revert Change to AE Comments
#INC-275551 Leads/Contacts - internal and customer comments Updated
#INC-269048 New inquiries from existing Contacts - Will Send Notification based on the owner of this Contact
#INC-268653 Lead Source Date changes in Contacts</description>
    <environments>Default</environments>
    <formulas>
        <name>didNotAttend</name>
        <dataType>Boolean</dataType>
        <expression>OR(
  CONTAINS(LOWER({!$Record.Notes__c}), &quot;did not attend&quot;),
  CONTAINS(LOWER({!$Record.Notes__c}), &quot;not attend&quot;)
)</expression>
    </formulas>
    <formulas>
        <name>New_AccountEngagementComment</name>
        <dataType>String</dataType>
        <expression>TRIM(
    SUBSTITUTE(
        $Record.pi__comments__c,
        &apos;202&apos;,
        BR() &amp; &apos;202&apos;
    )
)</expression>
    </formulas>
    <formulas>
        <name>New_iCaptureComment</name>
        <dataType>String</dataType>
        <expression>IF(
    ISBLANK({!$Record__Prior.iCapture_Comments__c}),
    /* first time, nothing to stack */
    {!$Record.iCapture_Comments__c},
    /* else: new on top, old below */
    {!$Record.iCapture_Comments__c} &amp;
    BR() &amp;
    {!$Record__Prior.iCapture_Comments__c}
)</expression>
    </formulas>
    <formulas>
        <name>New_NotesMarketingComment</name>
        <dataType>String</dataType>
        <expression>IF(
    ISBLANK({!$Record__Prior.Notes__c}),
    /* first time, nothing to stack */
    {!$Record.Notes__c},
    /* else: new on top, old below */
    {!$Record.Notes__c} &amp;
    BR() &amp;
    {!$Record__Prior.Notes__c}
)</expression>
    </formulas>
