                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Follow_Up_Task_2</targetReference>
            </connector>
            <label>Not related to TR</label>
        </rules>
        <rules>
            <name>Tr_already_Present</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.TR__c</leftValueReference>
