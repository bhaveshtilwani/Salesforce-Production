    <decisions>
        <name>If_task_is_who_id_is_equal_to_TR_id</name>
        <label>If task is ownerid is equal to TR id</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>TR_already_has_a_task</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Task_Record.OwnerId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.TR__r.Id</elementReference>
                </rightValue>
            </conditions>
            <label>TR already has a task</label>
        </rules>
        <rules>
            <name>Task_who_id_is_not_equal_to_TR_id</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Coordination</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.TR__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.TR__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record.TR__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Copy_3_of_Create_Follow_Up_Task</targetReference>
            </connector>
            <label>Task ownerid is not equal to TR id</label>
        </rules>
    </decisions>
