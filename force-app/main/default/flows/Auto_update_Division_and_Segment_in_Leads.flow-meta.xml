<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description>Checks if a Division exists for the given Business Unit by evaluating if the &apos;Division&apos; field from the &apos;Get Division for Business Unit&apos; step is not null. Based on this condition, it determines whether to update the Lead Division or proceed with the default outcome.</description>
        <name>Check_if_Division_Exists</name>
        <label>Check if Division Exists</label>
        <locationX>182</locationX>
        <locationY>395</locationY>
        <defaultConnector>
            <targetReference>Get_Segment_Based_on_Division</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Check_if_Division_Existsrec</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Division_for_Business_Unit.Division__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Lead_Div</targetReference>
            </connector>
            <label>Check if Division Exists for rec</label>
        </rules>
    </decisions>
    <decisions>
        <description>This verifies if a Segment record exists for the division. If found, it updates the Lead&apos;s Segment__c field.</description>
        <name>Check_if_Segment_Exists</name>
        <label>Check if Segment Exists</label>
        <locationX>182</locationX>
        <locationY>803</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Check_if_Segment_Exists_fo_rrec</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Segment_Based_on_Division.Division__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Lead_Seg</targetReference>
            </connector>
            <label>Check if Segment Exists fo rrec</label>
        </rules>
    </decisions>
    <description>Flow updates the Lead&apos;s Division__c and Segment__c fields using Business Unit and Division mappings for accurate data alignment.</description>
    <environments>Default</environments>
    <interviewLabel>Auto update Division and Segment in Leads {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Auto update Division and Segment in Leads</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Retrieve the Division associated with the Business Unit from the BusinessUnitToDivisionMapping object based on the selected Business Unit value.</description>
        <name>Get_Division_for_Business_Unit</name>
        <label>Get Division for Business Unit</label>
        <locationX>182</locationX>
        <locationY>287</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_if_Division_Exists</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Product_Line__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Product_Line__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>BusinessUnitToDivisionMapping__mdt</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Retrieve the Segment associated with the Division from the DivisionToSegmentMapping object based on the selected Division value.</description>
        <name>Get_Segment_Based_on_Division</name>
        <label>Get Segment Based on Division</label>
        <locationX>182</locationX>
        <locationY>695</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_if_Segment_Exists</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Division__c</field>
            <operator>EqualTo</operator>
