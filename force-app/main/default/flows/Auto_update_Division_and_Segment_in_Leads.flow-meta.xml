            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>DivisionToSegmentMapping__mdt</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <description>Updates the Division__c field on the Lead using the value from &apos;BusinessUnitToDivisionMapping,&apos; ensuring the Lead aligns with the correct Division based on its associated Business Unit.</description>
        <name>Update_Lead_Div</name>
        <label>Update Lead Div</label>
        <locationX>50</locationX>
        <locationY>503</locationY>
        <connector>
            <targetReference>Get_Segment_Based_on_Division</targetReference>
        </connector>
        <inputAssignments>
            <field>Division__c</field>
            <value>
                <elementReference>Get_Division_for_Business_Unit.Division__c</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
