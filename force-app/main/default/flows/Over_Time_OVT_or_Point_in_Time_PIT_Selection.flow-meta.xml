    <formulas>
        <name>isDisabledCustomSTd</name>
        <dataType>Boolean</dataType>
        <expression>IF({!Product_Type} = &apos;SERPROD&apos;, False, True)</expression>
    </formulas>
    <formulas>
        <name>revenueRecogType</name>
        <dataType>String</dataType>
        <expression>IF(
  ISPICKVAL({!quoteRecord.Product_Type__c}, &quot;NRE/PTYPE&quot;),
  &quot;NRE&quot;,
  IF(
    ISPICKVAL({!quoteRecord.Product_Type__c}, &quot;SERV/FEE&quot;),
    &quot;SERV&quot;,
    IF(
      AND(
        ISPICKVAL({!quoteRecord.Product_Type__c}, &quot;SERPROD&quot;),
        ISPICKVAL({!quoteRecord.Custom_vs_Standard__c}, &quot;Standard Terms&quot;)
      ),
      &quot;PIT&quot;,
      
      IF(
        AND(
          ISPICKVAL({!quoteRecord.Product_Type__c}, &quot;SERPROD&quot;),
          ISPICKVAL({!quoteRecord.Custom_vs_Standard__c}, &quot;Custom&quot;),
          ISPICKVAL({!quoteRecord.Agreement_Type__c}, &quot;Standard Terms&quot;)
        ),
        &quot;OVT&quot;,
        
        IF(
          AND(
            ISPICKVAL({!quoteRecord.Product_Type__c}, &quot;SERPROD&quot;),
            ISPICKVAL({!quoteRecord.Custom_vs_Standard__c}, &quot;Custom&quot;),
            ISPICKVAL({!quoteRecord.Agreement_Type__c}, &quot;Negotiated Agreement&quot;),
            ISPICKVAL({!quoteRecord.RighttoCostProfitUpon_Cancellation__c}, &quot;Yes&quot;)
          ),
          &quot;OVT&quot;,
          
          IF(
            AND(
              ISPICKVAL({!quoteRecord.Product_Type__c}, &quot;SERPROD&quot;),
              ISPICKVAL({!quoteRecord.Custom_vs_Standard__c}, &quot;Custom&quot;),
              ISPICKVAL({!quoteRecord.Agreement_Type__c}, &quot;Negotiated Agreement&quot;),
              ISPICKVAL({!quoteRecord.RighttoCostProfitUpon_Cancellation__c}, &quot;No&quot;)
            ),
            &quot;PIT&quot;,
            
            &quot;&quot;
          )
        )
      )
    )
  )
)</expression>
    </formulas>
    <formulas>
        <name>rrtQuoteValue</name>
        <dataType>String</dataType>
        <expression>IF(
