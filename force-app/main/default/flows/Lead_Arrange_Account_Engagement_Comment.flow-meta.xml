<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Set_Account_Engagement</name>
        <label>Set Account Engagement</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.pi__comments__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>New_AccountEngagementComment</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <description>#INC-275551  Leads - internal and customer comments</description>
    <environments>Default</environments>
    <formulas>
        <name>New_AccountEngagementComment</name>
        <dataType>String</dataType>
        <expression>IF(
    ISBLANK({!$Record__Prior.pi__comments__c}),
    /* first time, nothing to stack */
    {!$Record.pi__comments__c},
    /* else: new on top, old below */
   {!$Record.pi__comments__c} &amp;
    BR() &amp;
    {!$Record__Prior.pi__comments__c}
)</expression>
    </formulas>
    <formulas>
        <name>timezone</name>
        <dataType>String</dataType>
        <expression>IF(
    AND(
        /* today &gt;= 2nd Sunday of March */
        DATEVALUE($Flow.CurrentDateTime) &gt;=
            DATE(
                YEAR( DATEVALUE($Flow.CurrentDateTime) ),
                3,
                14
            )
            -
            MOD(
                DATE(
                    YEAR( DATEVALUE($Flow.CurrentDateTime) ),
                    3,
                    14
                ) - DATE(1900, 1, 7),
                7
            ),

        /* today &lt; 1st Sunday of November */
        DATEVALUE($Flow.CurrentDateTime) &lt;
            DATE(
                YEAR( DATEVALUE($Flow.CurrentDateTime) ),
                11,
                7
            )
            -
            MOD(
                DATE(
                    YEAR( DATEVALUE($Flow.CurrentDateTime) ),
                    11,
                    7
                ) - DATE(1900, 1, 7),
                7
            )
    ),
    &quot;EDT&quot;,
    &quot;EST&quot;
)</expression>
    </formulas>
    <interviewLabel>Lead - Arrange Account Engagement Comment {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Lead - Arrange Account Engagement Comment</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Set_Account_Engagement</targetReference>
        </connector>
        <filterLogic>or</filterLogic>
        <filters>
            <field>pi__comments__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>pi__comments__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Lead</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Obsolete</status>
</Flow>
