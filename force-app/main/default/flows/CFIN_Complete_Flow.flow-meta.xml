<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description>Check bypass flag is enabled to prevent flow processing.</description>
        <name>Is_Bypass_Enabled</name>
        <label>Is Bypass Enabled?</label>
        <locationX>176</locationX>
        <locationY>395</locationY>
        <defaultConnector>
            <targetReference>Update_CFIN_Status_as_Confirmed</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Bypass_Is_True</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Bypass_Record.Bypass_Flow_c__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>Bypass Is True</label>
        </rules>
    </decisions>
    <description>When the Account field &apos;CFIN Completed and Confirmed&apos; is True, update &apos;CFIN Status&apos; to &apos;CFIN Confirmed&apos;.
(Migrated Workflow Rule: CFIN Complete)</description>
    <environments>Default</environments>
    <interviewLabel>CFIN Complete {!$Flow.CurrentDateTime}</interviewLabel>
    <label>CFIN Complete</label>
    <migratedFromWorkflowRuleName>CFIN Complete</migratedFromWorkflowRuleName>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Retrieve the bypass record from custom metadata to determine if the bypass is enabled.</description>
        <name>Get_Bypass_Record</name>
        <label>Get Bypass Record</label>
        <locationX>176</locationX>
        <locationY>287</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Is_Bypass_Enabled</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Account_Flow_Bypass</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Flow_Bypass__mdt</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <description>Update CFIN status when Cifin completed and confirmed</description>
        <name>Update_CFIN_Status_as_Confirmed</name>
        <label>Update CFIN Status as Confirmed</label>
        <locationX>308</locationX>
        <locationY>503</locationY>
        <inputAssignments>
            <field>CFIN_Status__c</field>
            <value>
                <stringValue>CFIN Confirmed</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Bypass_Record</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterFormula>AND(
  {!$Record.CFIN_Completed_and_Confirmed__c} = TRUE,
  NOT(
    OR(
      {!$Record.RecordType.DeveloperName} = &quot;SAP_Asia&quot;,
      {!$Record.RecordType.DeveloperName} = &quot;SAP_Germany&quot;,
      {!$Record.RecordType.DeveloperName} = &quot;SAP_NA_Montreal&quot;,
      {!$Record.RecordType.DeveloperName} = &quot;S4_Boulder&quot;
    )
  )
)</filterFormula>
        <object>Account</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
