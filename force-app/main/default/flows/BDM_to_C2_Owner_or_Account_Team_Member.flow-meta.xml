    <decisions>
        <name>BDM</name>
        <label>BDM</label>
        <locationX>542</locationX>
        <locationY>278</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>BDM_Changed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.BDM__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.BDM__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_C2_Owner</targetReference>
            </connector>
            <label>BDM Changed</label>
        </rules>
    </decisions>
    <decisions>
        <name>BDM_the_Owner</name>
        <label>BDM the Owner</label>
        <locationX>763</locationX>
        <locationY>260</locationY>
        <defaultConnector>
            <targetReference>Get_C2_Account_Team</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not the Owner</defaultConnectorLabel>
        <rules>
            <name>BDM_Owner</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Parent.OwnerId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.BDM__r.User_ID__c</elementReference>
                </rightValue>
            </conditions>
            <label>BDM Owner</label>
        </rules>
    </decisions>
    <decisions>
        <name>Owner_is_Admin_or_Inactive</name>
        <label>Owner is Admin or Inactive</label>
        <locationX>851</locationX>
        <locationY>613</locationY>
        <defaultConnector>
            <targetReference>BDM_the_Owner</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Active Non-Admin</defaultConnectorLabel>
        <rules>
            <name>Admin_or_Inactive</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Get_C2_Owner.Owner.Profile_Name__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>System Administrator</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_C2_Owner.Owner.Profile_Name__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Operations Admin</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_C2_Owner.Owner.IsActive</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_C2_Owner</targetReference>
            </connector>
            <label>Admin or Inactive</label>
        </rules>
    </decisions>
    <decisions>
        <name>Part_of_the_Team</name>
        <label>Part of the Team</label>
        <locationX>1025</locationX>
        <locationY>498</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Not_Part_of_the_Team</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_C2_Account_Team</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Add_to_Team</targetReference>
            </connector>
            <label>Not Part of the Team</label>
        </rules>
    </decisions>
