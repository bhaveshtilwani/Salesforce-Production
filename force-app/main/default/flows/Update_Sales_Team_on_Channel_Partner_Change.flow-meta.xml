<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description>upda</description>
        <name>update_channel_partner</name>
        <label>update channel partner</label>
        <locationX>446</locationX>
        <locationY>287</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Updated_from_Blank_to_a_Value</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior.Channel_Partner_Distributor__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Channel_Partner_Distributor__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Sales_Team_to_WW_Channel_Sales_Blank_to_Value</targetReference>
            </connector>
            <label>Updated from Blank to a Value</label>
        </rules>
        <rules>
            <name>Updated_from_One_Value_to_Another</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior.Channel_Partner_Distributor__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Channel_Partner_Distributor__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Channel_Partner_Distributor__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Channel_Partner_Distributor__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Keep_Sales_Team_as_WW_Channel_Sales_Value_to_Value</targetReference>
            </connector>
            <label>Updated from One Value to Another</label>
        </rules>
        <rules>
            <name>Cleared_Set_to_Blank</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior.Channel_Partner_Distributor__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Channel_Partner_Distributor__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Revert_Sales_Team_to_Lead_Owner_s_Sales_Team_Cleared</targetReference>
            </connector>
            <label>Cleared (Set to Blank)</label>
        </rules>
    </decisions>
    <description>This flow updates the Sales Team field on the Lead object when the Channel Partner/Distributor field is updated</description>
    <environments>Default</environments>
    <interviewLabel>Update Sales Team on Channel Partner Change {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Update Sales Team on Channel Partner Change v1</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <description>This keeps the Sales Team as WW Channel Sales when the Channel Partner/Distributor field is updated from one value to another.</description>
        <name>Keep_Sales_Team_as_WW_Channel_Sales_Value_to_Value</name>
        <label>Keep Sales Team as WW Channel Sales (Value to Value)</label>
        <locationX>314</locationX>
        <locationY>395</locationY>
        <inputAssignments>
            <field>Sales_TeamNEW__c</field>
            <value>
                <stringValue>WW Channel Sales</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <description>This reverts the Sales Team to the Lead Owner’s Sales Team when the Channel Partner/Distributor field is cleared (set to blank)</description>
        <name>Revert_Sales_Team_to_Lead_Owner_s_Sales_Team_Cleared</name>
        <label>Revert Sales Team to Lead Owner&apos;s Sales Team (Cleared)</label>
        <locationX>578</locationX>
        <locationY>395</locationY>
        <inputAssignments>
            <field>Sales_TeamNEW__c</field>
            <value>
                <elementReference>$Record.Owner:User.Sales_TeamNEW__c</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <description>This action updates the Sales Team to &apos;WW Channel Sales&apos; when the Channel Partner/Distributor is updated from blank to a value.</description>
        <name>Update_Sales_Team_to_WW_Channel_Sales_Blank_to_Value</name>
        <label>Update Sales Team to WW Channel Sales (Blank to Value)</label>
        <locationX>50</locationX>
        <locationY>395</locationY>
        <inputAssignments>
            <field>Sales_TeamNEW__c</field>
            <value>
                <stringValue>WW Channel Sales</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>320</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>update_channel_partner</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Channel_Partner_Distributor__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Sales_TeamNEW__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Industrial Curing Worldwide</stringValue>
            </value>
        </filters>
        <object>Lead</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
