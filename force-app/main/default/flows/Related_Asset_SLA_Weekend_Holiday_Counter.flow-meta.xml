        </rules>
    </decisions>
    <description>#INC-283997 Toronto RMA&apos;s - time/clock</description>
    <environments>Default</environments>
    <formulas>
        <name>CountSLAWeekendHoliday</name>
        <dataType>Number</dataType>
        <expression>IF(
  ISBLANK({!For_Each_Related_Asset.SLA_Weekends_Holidays__c}),
  1,
  {!For_Each_Related_Asset.SLA_Weekends_Holidays__c} + 1
)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>isWeekend</name>
        <dataType>Boolean</dataType>
        <expression>OR(
  WEEKDAY(TODAY()) = 1,
  WEEKDAY(TODAY()) = 7
)</expression>
    </formulas>
