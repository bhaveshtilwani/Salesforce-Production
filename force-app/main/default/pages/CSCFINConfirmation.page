<apex:page standardController="Account">

<apex:form >

  <apex:pageBlock title="CS Confirmation">

    <apex:pageBlockSection title="CUSTOMER AND CONTACT" columns="2">
      <apex:outputField value="{! Account.Source_BP_Number__c}"/>
      <apex:outputField value="{! Account.Person_Name__c}"/>
      <apex:outputField value="{! Account.BP_NAME__c}"/>
      <apex:outputField value="{! Account.EMAIL_ADDRESS__c}"/>
      <apex:outputField value="{! Account.Party_Type__c}"/>
      <apex:outputField value="{! Account.PHONE_NUMBER__c}"/>
      <apex:outputField value="{! Account.Language__c}"/>
        </apex:pageBlockSection>
    
     <apex:pageBlockSection title="BILLING ADDRESS" columns="1">
      <apex:outputField value="{! Account.BillingStreet}"/>
      <apex:outputField value="{! Account.BillingCity}"/>
      <apex:outputField value="{! Account.BillingState}"/>
      <apex:outputField value="{! Account.BillingCountry}"/>
      <apex:outputField value="{! Account.BillingPostalCode}"/>
    </apex:pageBlockSection>
      
        <apex:pageBlockSection title="Send to CFIN" columns="1">
            All details above are confirmed.
      <apex:inputCheckbox value="{! Account.CS_Confirmed_and_Forward_to_CFIN__c}"/>
    </apex:pageBlockSection>
        
    <apex:pageBlockButtons location="bottom">
      <apex:commandButton action="{! Save }" value="Send to CFIN"/>
    </apex:pageBlockButtons>
    
  </apex:pageBlock>

</apex:form>

</apex:page>