<apex:page lightningStylesheets="true" standardController="Case">

<apex:form >

  <apex:pageBlock title="Assign to CS Team">

    <apex:pageBlockSection title="Sample Loaner Details" columns="1">
      <apex:outputField value="{! Case.Product_Family__c}"/>
      <apex:outputField value="{! Case.Region__c}"/>
      <apex:outputField value="{! Case.CS_Site__c}"/>
      <apex:inputCheckbox value="{! Case.Assigned_to_CS_Group__c}"/>
    </apex:pageBlockSection>
        
    <apex:pageBlockButtons location="bottom">
      <apex:commandButton action="{! Save }" value="Save"/>
    </apex:pageBlockButtons>
    
  </apex:pageBlock>

</apex:form>

</apex:page>