<apex:page standardController="Order" lightningStylesheets="true">

<apex:form >

  <apex:pageBlock title="Purchase Order & Intercompany Order">

        <apex:pageBlockSection title="Purchase Order Inputs" columns="2">
      <apex:inputField value="{! Order.Interco_Bill_Sold_to_Account__c}"/>
      <apex:inputField value="{! Order.Vendor_Site__c}"/>
      <apex:inputField value="{! Order.Interco_Ship_to_Account__c}"/>
      <apex:inputField value="{! Order.Purchase_Order_Type__c}"/>
      <apex:inputField value="{! Order.Create_Purchase_Order__c}"/>       
    </apex:pageBlockSection>
        
    <apex:pageBlockButtons location="bottom">
      <apex:commandButton action="{!save}" value="Create Purchase Order"/>
    </apex:pageBlockButtons>
    
  </apex:pageBlock>

</apex:form>

</apex:page>