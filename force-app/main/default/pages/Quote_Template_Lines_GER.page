<apex:page showHeader="false" sidebar="false" cache="false" contentType="text/xml" controller="Quote_Template_Lines_Controller" >
    <block font-size="9px"  margin-top="1mm">
        <apex:repeat var="site" value="{!sites}">
            <block>
                <block font-size="9px"  font-weight="bold">
                    {!HTMLENCODE(siteById[site].Legal_Company_Name__c)}
                </block>    
                <block font-size="9px" >
                    {!HTMLENCODE(siteById[site].Site_Address_Line_1__c)}
                </block> 
                <block font-size="9px" >
                    {!HTMLENCODE(siteById[site].Site_City__c)}, {!HTMLENCODE(siteById[site].Site_State_Province__c)} {!HTMLENCODE(siteById[site].Site_Zip_Postal_Code__c)}
                </block>
                <block font-size="9px" >
                    {!HTMLENCODE(siteById[site].Site_Country__c)}
                </block>  
                <block font-size="9px" >
                    &nbsp;    
                </block> 
                <block font-size="9px" >
                    <inline text-decoration="underline" font-weight="bold">Bestellanleitung:</inline> {!HTMLENCODE(siteById[site].Order_Instructions_GER__c)}
                </block>   
                <apex:outputPanel layout="none" rendered="{!NOT(q.Incoterm_Override__c)}"> 
                    <block font-size="9px" >
                         <inline text-decoration="underline" font-weight="bold">Lieferung:</inline> {!HTMLENCODE(siteById[site].Shipping_Terms__c)}, {!HTMLENCODE(siteById[site].Shipping_Terms_2__c)} 
                    </block> 
                </apex:outputPanel>
                <apex:outputPanel layout="none" rendered="{!q.Incoterm_Override__c}">
                     <block font-size="9px" >
                        <inline text-decoration="underline" font-weight="bold">Lieferung:</inline> {!q.Override_IncoTerm_Name__c}, {!HTMLENCODE(siteById[site].Shipping_Terms_2__c)}  
                     </block>   
                </apex:outputPanel>
                <apex:outputPanel layout="none" rendered="{!NOT(q.Credit_Terms_Override__c)}"> 
                    <block font-size="9px" >
                      <inline text-decoration="underline" font-weight="bold">Zahlung:</inline> {!HTMLENCODE(siteById[site].Payment_Details__c)} 
                    </block>
                </apex:outputPanel>
                <apex:outputPanel layout="none" rendered="{!q.Credit_Terms_Override__c}"> 
                    <block font-size="9px" >
                        <inline text-decoration="underline" font-weight="bold">Zahlung:</inline> {!q.Override_Credit_Terms_Name__c} 
                    </block>   
