<apex:page lightningStylesheets="true" controller="approverController">

<apex:form >

  <apex:pageBlock title="Quote Approvals">
    <apex:pageBlockTable value="{!app}" var="appobj">
      <apex:column value="{! appobj.Name}"/>
      <apex:column value="{! appobj.sbaa__DelegationStart__c  }"/>
      <apex:column value="{! appobj.sbaa__DelegationEnd__c}"/>
      <apex:column value="{! appobj.sbaa__DelegatedApprover__c}"/>
    </apex:pageBlockTable>
      <apex:pageBlockButtons >
          <apex:commandButton value="Delegate" action="{!delegate}"/>
      </apex:pageBlockButtons>
  </apex:pageBlock>
</apex:form>

</apex:page>