<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Primary_Email_Address</fullName>
    <active>true</active>
    <errorConditionFormula>AND( Is_Primary__c ,  Account__r.Number_of_Email_Addresses__c = 1)</errorConditionFormula>
    <errorDisplayField>Is_Primary__c</errorDisplayField>
    <errorMessage>Only one Primary Email Address is allowed.</errorMessage>
</ValidationRule>
