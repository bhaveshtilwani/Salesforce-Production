<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Prevent_Edit_After_Approval</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
    NOT(ISNEW()),
    OR(
        ISPICKVAL(PRIORVALUE(Status__c), &quot;Approved&quot;),
        ISPICKVAL(PRIORVALUE(Status__c), &quot;Rejected&quot;)
    )
)</errorConditionFormula>
    <errorMessage>This record cannot be edited because its status is Approved or Rejected.</errorMessage>
</ValidationRule>
