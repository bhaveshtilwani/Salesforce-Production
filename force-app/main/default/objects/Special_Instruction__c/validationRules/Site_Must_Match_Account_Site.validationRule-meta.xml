<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Site_Must_Match_Account_Site</fullName>
    <active>true</active>
    <errorConditionFormula>(TEXT(Account__r.ERP_Site__c) &lt;&gt; TEXT(Site__c))  
&amp;&amp; (TEXT( Order__r.Site__c ) &lt;&gt; TEXT(Site__c))
&amp;&amp; (TEXT( Order_Product__r.Order.Site__c ) &lt;&gt; TEXT(Site__c))</errorConditionFormula>
    <errorDisplayField>Site__c</errorDisplayField>
    <errorMessage>Account or Order ERP Site must be same.</errorMessage>
</ValidationRule>
