<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Cant_Cancel_if_there_are_deliveries</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
ISPICKVAL( Site__c , &quot;Boulder&quot;),
 Delivered_Quantity__c &gt; 0,
 Requested_Quantity_Change__c = 0)</errorConditionFormula>
    <errorDisplayField>Requested_Quantity_Change__c</errorDisplayField>
    <errorMessage>Cancellation is not allowed if there are deliveries. You can split the line then cancel the line with remaining Quantity.</errorMessage>
</ValidationRule>
