<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>SSD_Required_for_SalemMIA</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
ISBLANK( Scheduled_Ship_Date__c ),
 Order.RecordType.Name = &quot;SAP NA Salem/MIA&quot;)</errorConditionFormula>
    <errorDisplayField>Scheduled_Ship_Date__c</errorDisplayField>
    <errorMessage>Scheduled Ship Date Required.</errorMessage>
</ValidationRule>
