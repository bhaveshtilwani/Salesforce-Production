<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Unit_of_Measure_required_for_Billerica</fullName>
    <active>false</active>
    <description>Unit_of_Measure_required_for_Billerica</description>
    <errorConditionFormula>AND(  ISPICKVAL(Order.Site__c  , &quot;Billerica&quot;),
ISBLANK( Unit_of_Measure__c)
)</errorConditionFormula>
    <errorDisplayField>Unit_of_Measure__c</errorDisplayField>
    <errorMessage>Unit of Measure is required.</errorMessage>
</ValidationRule>
