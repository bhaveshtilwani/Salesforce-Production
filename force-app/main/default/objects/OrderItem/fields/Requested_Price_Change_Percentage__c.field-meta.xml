<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Requested_Price_Change_Percentage__c</fullName>
    <formula>IF(Requested_Price_Change__c &gt; 0, ( Requested_Price_Change__c -  UnitPrice )/ UnitPrice, 0)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Requested Price Change (%)</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <type>Percent</type>
</CustomField>
