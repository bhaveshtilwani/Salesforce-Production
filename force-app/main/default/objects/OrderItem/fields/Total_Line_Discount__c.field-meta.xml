<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Total_Line_Discount__c</fullName>
    <description>Total discount for current line item</description>
    <formula>1 - ((1 - Discount_1__c) * (1 - Discount_2__c))</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <inlineHelpText>This result will be used in the Discount field in QAD</inlineHelpText>
    <label>Total Line Discount</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <type>Percent</type>
</CustomField>
