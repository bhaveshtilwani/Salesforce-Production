<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Primary_Address_Validation_Rule</fullName>
    <active>true</active>
    <errorConditionFormula>AND(Primary__c, Account__r.Number_of_Primary_Address__c  = 1)</errorConditionFormula>
    <errorDisplayField>Primary__c</errorDisplayField>
    <errorMessage>Only one Primary Address is allowed.</errorMessage>
</ValidationRule>
