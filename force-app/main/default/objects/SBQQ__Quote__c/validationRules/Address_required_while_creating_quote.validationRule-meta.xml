<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Address_required_while_creating_quote</fullName>
    <active>true</active>
    <errorConditionFormula>OR( 

ISBLANK(SBQQ__Account__r.BillingCountry), ISBLANK(SBQQ__Account__r.BillingPostalCode) 

)</errorConditionFormula>
    <errorDisplayField>SBQQ__Account__c</errorDisplayField>
    <errorMessage>Please enter the address fields on Business name account</errorMessage>
</ValidationRule>
