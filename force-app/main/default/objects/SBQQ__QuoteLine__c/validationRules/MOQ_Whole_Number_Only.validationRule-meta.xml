<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>MOQ_Whole_Number_Only</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
NOT(ISBLANK(MOQ__c)),
NOT(REGEX(MOQ__c, &quot;^[0-9]+$&quot;))
)</errorConditionFormula>
    <errorMessage>MOQ must be a whole number. Decimal values and non-numeric characters are not allowed.</errorMessage>
</ValidationRule>
