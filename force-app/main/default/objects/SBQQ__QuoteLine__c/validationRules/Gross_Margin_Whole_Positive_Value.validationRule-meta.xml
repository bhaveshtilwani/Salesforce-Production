<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Gross_Margin_Whole_Positive_Value</fullName>
    <active>true</active>
    <description>Gross_Margin_Whole_Positive_Value</description>
    <errorConditionFormula>OR(
Forecasted_Gross_Margin__c &lt; 0,
Forecasted_Gross_Margin__c &gt; 1,
MOD(Forecasted_Gross_Margin__c * 100, 1) &lt;&gt; 0
)</errorConditionFormula>
    <errorDisplayField>Forecasted_Gross_Margin__c</errorDisplayField>
    <errorMessage>Gross Margin must be a whole percentage between 0% and 100%. Decimal and negative values are not allowed.</errorMessage>
</ValidationRule>
