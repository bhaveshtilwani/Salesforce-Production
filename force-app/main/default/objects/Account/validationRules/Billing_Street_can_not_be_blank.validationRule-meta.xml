<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Billing_Street_can_not_be_blank</fullName>
    <active>false</active>
    <errorConditionFormula>AND($RecordType.Name = &quot;Business Name&quot;,(ISBLANK(BillingStreet)))</errorConditionFormula>
    <errorDisplayField>BillingStreet</errorDisplayField>
    <errorMessage>Billing Street is Required</errorMessage>
</ValidationRule>
