<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Cant_edit_while_integration_in_Process</fullName>
    <active>false</active>
    <description>In Process/In Progress</description>
    <errorConditionFormula>OR(ISPICKVAL(SFDC_Integration_Status__c, &quot;In Process&quot;),
ISPICKVAL(SFDC_Integration_Status__c, &quot;In Progress&quot;))</errorConditionFormula>
    <errorMessage>Can not edit Account when Integration is in process</errorMessage>
</ValidationRule>
