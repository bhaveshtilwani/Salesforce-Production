<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Website_Format_validation_rule</fullName>
    <active>false</active>
    <errorConditionFormula>NOT( ISBLANK(Website) || REGEX( Website , &apos;([A-z0-9-]{1,63}\\.)+[A-z]{2,6}&apos;))</errorConditionFormula>
    <errorDisplayField>Website</errorDisplayField>
    <errorMessage>Invalid URL.</errorMessage>
</ValidationRule>
