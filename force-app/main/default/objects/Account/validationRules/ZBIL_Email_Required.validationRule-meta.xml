<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>ZBIL_Email_Required</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
ISPICKVAL( Account_Group__c , &quot;Billing email address - ZBIL&quot;),
ISBLANK( Email__c ))</errorConditionFormula>
    <errorDisplayField>Email__c</errorDisplayField>
    <errorMessage>Email is required for ZBIL.</errorMessage>
</ValidationRule>
