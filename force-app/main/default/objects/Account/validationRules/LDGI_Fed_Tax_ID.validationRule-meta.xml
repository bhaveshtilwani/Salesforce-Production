<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>LDGI_Fed_Tax_ID</fullName>
    <active>false</active>
    <description>Federal Tax ID Number is required if US Account</description>
    <errorConditionFormula>AND(
 $RecordType.Name = &quot;QAD - LDGI&quot;,
 ISPICKVAL(BillingCountryCode , &quot;US&quot;),
ISBLANK(Federal_Tax_ID_Number__c))</errorConditionFormula>
    <errorDisplayField>Federal_Tax_ID_Number__c</errorDisplayField>
    <errorMessage>Federal Tax ID Number is required for US Accounts</errorMessage>
</ValidationRule>
