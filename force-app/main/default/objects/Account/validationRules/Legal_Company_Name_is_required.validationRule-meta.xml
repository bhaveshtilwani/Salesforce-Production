<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Legal_Company_Name_is_required</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
ISPICKVAL( DW_Account_Type__c , &quot;Business Name&quot;),
ISBLANK( Legal_Company_Name__c ))</errorConditionFormula>
    <errorDisplayField>Legal_Company_Name__c</errorDisplayField>
    <errorMessage>Legal Company Names is required.</errorMessage>
</ValidationRule>
