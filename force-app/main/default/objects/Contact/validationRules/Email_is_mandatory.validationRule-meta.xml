<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Email_is_mandatory</fullName>
    <active>true</active>
    <description>Email is required to create a contact person in SAP</description>
    <errorConditionFormula>ISBLANK(Email)</errorConditionFormula>
    <errorDisplayField>Email</errorDisplayField>
    <errorMessage>Please enter an email</errorMessage>
</ValidationRule>
