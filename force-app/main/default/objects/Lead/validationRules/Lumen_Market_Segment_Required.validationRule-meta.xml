<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Lumen_Market_Segment_Required</fullName>
    <active>true</active>
    <description>Requires Lumen Market Segment only for Lumen Lead record type.</description>
    <errorConditionFormula>AND(
    $RecordType.DeveloperName = &quot;Lumen_Data&quot;,
    ISPICKVAL( Lumen_Market_Segment__c, &quot;&quot; ),
    $Profile.Name &lt;&gt; &quot;B2BMA Integration User&quot;
)</errorConditionFormula>
    <errorDisplayField>Lumen_Market_Segment__c</errorDisplayField>
    <errorMessage>Lumen Market Segment is required for Lumen Leads.</errorMessage>
</ValidationRule>
