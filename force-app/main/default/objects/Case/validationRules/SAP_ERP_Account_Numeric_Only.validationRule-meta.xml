<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>SAP_ERP_Account_Numeric_Only</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    NOT(ISBLANK(SAP_ERP_Account__c)),
    NOT(REGEX(SAP_ERP_Account__c, &quot;^[0-9]+$&quot;))
)</errorConditionFormula>
    <errorDisplayField>SAP_ERP_Account__c</errorDisplayField>
    <errorMessage>SAP ERP Account must contain numbers only.</errorMessage>
</ValidationRule>
