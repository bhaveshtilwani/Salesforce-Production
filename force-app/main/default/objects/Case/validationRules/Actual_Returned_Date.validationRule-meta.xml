<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Actual_Returned_Date</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
ISPICKVAL( Status , &quot;Returned&quot;),
ISNULL( Actual_Returned_Date__c ))</errorConditionFormula>
    <errorDisplayField>Actual_Returned_Date__c</errorDisplayField>
    <errorMessage>Please indicate date.</errorMessage>
</ValidationRule>
