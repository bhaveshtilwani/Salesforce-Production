<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Shipping_AWB</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
ISPICKVAL( Status, &quot;Shipped&quot;),
ISBLANK(Shipping_AWB_Tracking__c))</errorConditionFormula>
    <errorDisplayField>Shipping_AWB_Tracking__c</errorDisplayField>
    <errorMessage>Please indicate  AWB.</errorMessage>
</ValidationRule>
