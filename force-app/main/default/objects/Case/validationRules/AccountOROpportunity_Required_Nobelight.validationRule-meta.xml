<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>AccountOROpportunity_Required_Nobelight</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
$RecordType.DeveloperName = &quot;ACCTrial&quot;,

ISBLANK( Related_Account__c ),
ISBLANK( Related_Opportunity__c )

)</errorConditionFormula>
