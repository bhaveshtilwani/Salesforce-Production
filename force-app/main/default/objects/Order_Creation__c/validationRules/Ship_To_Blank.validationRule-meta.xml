<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Ship_To_Blank</fullName>
    <active>true</active>
    <errorConditionFormula>AND( 
ISBLANK( Ship_To_Account__c ),
 ISPICKVAL(Status__c , &quot;Converted&quot;))</errorConditionFormula>
    <errorMessage>Please select a Ship To Account</errorMessage>
</ValidationRule>
