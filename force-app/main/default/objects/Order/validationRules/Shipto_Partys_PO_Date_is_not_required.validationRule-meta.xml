<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Shipto_Partys_PO_Date_is_not_required</fullName>
    <active>true</active>
    <description>Ship-to Party&apos;s Purchase Order date is not required for SAP GER, Hamble site.</description>
    <errorConditionFormula>ISPICKVAL(Site__c, &quot;Hamble&quot;) 
&amp;&amp; ISPICKVAL(SFDC_Integration_Status__c, &apos;In Progress&apos;)
&amp;&amp; NOT(ISNULL( Ship_To_Party_s_PO_Date__c ))</errorConditionFormula>
    <errorDisplayField>Ship_To_Party_s_PO_Date__c</errorDisplayField>
    <errorMessage>Ship-to Party&apos;s Purchase Order Date is not require for selected site.</errorMessage>
</ValidationRule>
