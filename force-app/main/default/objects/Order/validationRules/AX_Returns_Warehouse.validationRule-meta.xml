<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>AX_Returns_Warehouse</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
ISPICKVAL( Site__c , &quot;Billerica&quot;),
ISPICKVAL( Order_Type__c , &quot;Customer Return&quot;),
ISPICKVAL (  Warehouse__c   , &quot;&quot;))</errorConditionFormula>
    <errorDisplayField>Warehouse__c</errorDisplayField>
    <errorMessage>Warehouse required for Customer Returns</errorMessage>
</ValidationRule>
