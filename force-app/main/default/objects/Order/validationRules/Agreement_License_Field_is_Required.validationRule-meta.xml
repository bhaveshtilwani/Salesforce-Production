<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Agreement_License_Field_is_Required</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL(Site__c, &quot;QSG&quot;),(ISPICKVAL(Usage__c, &quot;(DEF) Defence&quot;))
&amp;&amp;
ISBLANK( Agreement_License__c))</errorConditionFormula>
    <errorDisplayField>Agreement_License__c</errorDisplayField>
    <errorMessage>Agreement # / License # Field is Required</errorMessage>
</ValidationRule>
