<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Cost_Center_is_required_for_AX</fullName>
    <active>true</active>
    <description>Cost center is required for AX Billerica site</description>
    <errorConditionFormula>AND(ISPICKVAL( Site__c , &quot;Billerica&quot;),ISPICKVAL(SFDC_Integration_Status__c, &apos;In Progress&apos;) &amp;&amp;
ISBLANK(Cost_Center__c ))</errorConditionFormula>
    <errorDisplayField>Cost_Center__c</errorDisplayField>
    <errorMessage>Cost Center Is Required for Billerica</errorMessage>
</ValidationRule>
