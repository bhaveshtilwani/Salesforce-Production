<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Land_Product_Designation_Required</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
ISPICKVAL( Business_Unit__c , &quot;Land Equipment&quot;),
ISBLANK( Land_Product_Designation__c ))</errorConditionFormula>
    <errorDisplayField>Land_Product_Designation__c</errorDisplayField>
    <errorMessage>Land Product Designation required.</errorMessage>
</ValidationRule>
