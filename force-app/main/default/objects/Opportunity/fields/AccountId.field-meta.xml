<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>AccountId</fullName>
    <inlineHelpText>Name of account that Prospect is linked to. You can enter the account name, or select the account using the lookup icon.</inlineHelpText>
    <lookupFilter>
        <active>true</active>
        <booleanFilter>(2 AND (1 OR 3 OR 5)) OR 4</booleanFilter>
        <filterItems>
            <field>Account.DW_Account_Type__c</field>
            <operation>equals</operation>
            <value>Business Name</value>
        </filterItems>
        <filterItems>
            <field>Account.MK_Denial__c</field>
            <operation>notEqual</operation>
            <value>True</value>
        </filterItems>
        <filterItems>
            <field>Account.DW_Account_Type__c</field>
            <operation>equals</operation>
            <value>M&amp;A</value>
        </filterItems>
        <filterItems>
            <field>Account.RecordTypeId</field>
            <operation>equals</operation>
            <value>QAD - LDGI</value>
        </filterItems>
        <filterItems>
            <field>Account.RecordTypeId</field>
            <operation>equals</operation>
            <value>C2 Teledyne</value>
        </filterItems>
        <infoMessage>Prospects Must be created to Business Name DW Account Type</infoMessage>
        <isOptional>false</isOptional>
    </lookupFilter>
    <trackFeedHistory>false</trackFeedHistory>
    <trackHistory>true</trackHistory>
    <type>Lookup</type>
</CustomField>
