<messaging:emailTemplate subject="New Product Price Update Case {!relatedTo.CaseNumber} - Approval Rejected"
    recipientType="Contact"
    relatedToType="Case">

    <messaging:htmlEmailBody >
        <html>
        <body style="font-family: Arial, sans-serif; 
                     font-size: 14px; 
                     color: #333333;">

            <p>Hi {!recipient.FirstName},</p>

            <p>
                New product price update case
                <a href="{!LEFT($Api.Partner_Server_URL_600, FIND('/services', $Api.Partner_Server_URL_600))}/{!relatedTo.Id}"
                   style="color: #0176D3; text-decoration: none; font-weight: bold;">
                    {!relatedTo.CaseNumber}
                </a>
                is rejected. Please Ask PM to resubmit.
            </p>

            <p>
                Once resubmitted, you will be notified.
            </p>

            <p>Thanks,</p>

        </body>
        </html>
    </messaging:htmlEmailBody>

    <messaging:plainTextEmailBody >
Hi {!recipient.FirstName},

New product price update case {!relatedTo.CaseNumber} is rejected.

Please Ask PM to resubmit. Once resubmitted, you will be notified.

Case Link: {!LEFT($Api.Partner_Server_URL_600, FIND('/services', $Api.Partner_Server_URL_600))}/{!relatedTo.Id}

Thanks,
    </messaging:plainTextEmailBody>

</messaging:emailTemplate>